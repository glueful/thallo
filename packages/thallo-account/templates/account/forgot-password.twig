{% extends 'account/layout.twig' %}
{% block account_heading %}Reset your password{% endblock %}
{% block account %}
  <p class="account__notice">
    Enter your email and we'll send a reset code if an account exists.
  </p>
  <form method="post" action="/account/forgot-password" class="account__form">
    <label class="account__field">
      <span>Email</span>
      <input type="email" name="email" autocomplete="email" required>
    </label>
    <button type="submit" class="account__submit">Send reset code</button>
  </form>
  <p class="account__links">
    <a href="/account/login">Back to sign in</a>
  </p>
{% endblock %}
