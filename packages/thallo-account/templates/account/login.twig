{% extends 'account/layout.twig' %}
{% block account_heading %}Sign in{% endblock %}
{% block account %}
  <form method="post" action="/account/login" class="account__form">
    {# Carries a validated post-login redirect target. The controller only ever supplies a value
       that already passed AccountReturnPath, so hostile input is never reflected here. #}
    <input type="hidden" name="next" value="{{ next|default('') }}">
    <label class="account__field">
      <span>Email</span>
      <input type="email" name="email" value="{{ email|default('') }}" autocomplete="email" required>
    </label>
    <label class="account__field">
      <span>Password</span>
      <input type="password" name="password" autocomplete="current-password" required>
    </label>
    <div class="account__forgot">
      <a href="/account/forgot-password">Forgot password?</a>
    </div>
    <button type="submit" class="account__submit">Sign in</button>
  </form>
  <p class="account__links">
    <a href="/account/register">Create an account</a>
  </p>
{% endblock %}
