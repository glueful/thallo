{% extends 'account/layout.twig' %}
{% block account_heading %}Set a new password{% endblock %}
{% block account %}
  <form method="post" action="/account/reset-password" class="account__form">
    <label class="account__field">
      <span>New password</span>
      <input type="password" name="password" autocomplete="new-password" minlength="8" required>
    </label>
    <button type="submit" class="account__submit">Update password</button>
  </form>
{% endblock %}
