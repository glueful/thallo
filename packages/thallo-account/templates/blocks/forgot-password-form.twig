{# forgot-password-form — the request-a-reset-code form as a composable block (account-form-blocks
   plan Task 2). A PLAIN server form: recovery's neutral flow always redirects into the themed
   /account/verify-reset page, so there is no PRG-back consumer — no error node, no script, no
   return_to, no sessionStorage. Cache-safe: anonymous same-origin-guarded POST, no session CSRF
   token, no per-visitor state. #}
{% set heading = data.heading|default('')|trim %}
<div class="thallo-block thallo-block-forgot-password-form">
  <link rel="stylesheet" href="/_account/assets/account-blocks.css">
  {% if heading != '' %}<h2 class="thallo-block-forgot-password-form__heading">{{ heading }}</h2>{% endif %}
  <p class="thallo-block-forgot-password-form__notice">
    Enter your email and we'll send a reset code if an account exists.
  </p>
  <form method="post" action="/account/forgot-password" class="thallo-block-forgot-password-form__form">
    <label class="thallo-block-forgot-password-form__field">
      <span>Email</span>
      <input type="email" name="email" autocomplete="email" required>
    </label>
    <button type="submit" class="thallo-block-forgot-password-form__submit">Send reset code</button>
  </form>
</div>
