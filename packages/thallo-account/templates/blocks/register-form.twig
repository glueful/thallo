{# register-form — the create-account form as a composable block (account-form-blocks plan Task 2).
   A PLAIN server form: registration's neutral flow always redirects into the themed
   /account/verify page (the emailed-OTP step travels on an HttpOnly cookie), so there is no
   PRG-back consumer — no error node, no script, no return_to, no sessionStorage. Cache-safe:
   anonymous same-origin-guarded POST, no session CSRF token, no per-visitor state. #}
{% set heading = data.heading|default('')|trim %}
<div class="thallo-block thallo-block-register-form">
  <link rel="stylesheet" href="/_account/assets/account-blocks.css">
  {% if heading != '' %}<h2 class="thallo-block-register-form__heading">{{ heading }}</h2>{% endif %}
  <form method="post" action="/account/register" class="thallo-block-register-form__form">
    <label class="thallo-block-register-form__field">
      <span>First name</span>
      <input type="text" name="first_name" autocomplete="given-name" required>
    </label>
    <label class="thallo-block-register-form__field">
      <span>Last name</span>
      <input type="text" name="last_name" autocomplete="family-name" required>
    </label>
    <label class="thallo-block-register-form__field">
      <span>Email</span>
      <input type="email" name="email" autocomplete="email" required>
    </label>
    <label class="thallo-block-register-form__field">
      <span>Password</span>
      <input type="password" name="password" autocomplete="new-password" minlength="8" required>
    </label>
    <button type="submit" class="thallo-block-register-form__submit">Create account</button>
  </form>
</div>
