{% set logo = site_logo() %}
{% set inner %}{% if logo %}<img class="lemma-block-logo__image" src="{{ logo }}" alt="{{ site.name|default('') }}">{% else %}<span class="lemma-block-logo__name">{{ site.name|default('') }}</span>{% endif %}{% endset %}
<div class="lemma-block lemma-block-logo lemma-block-logo--{{ data.size|default('medium') }}">
  {% if data.link_home is not defined or data.link_home %}<a class="lemma-block-logo__link" href="/">{{ inner }}</a>{% else %}{{ inner }}{% endif %}
</div>
