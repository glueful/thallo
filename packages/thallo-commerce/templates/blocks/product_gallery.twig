{# product_gallery — the product's images (type layouts plan C1): the cover, and thumbnails that
   swap it (shop.js) when there are more, as shop/product.twig shows them. Every URL came
   pre-resolved through the anonymous-media authority; a product with none renders nothing. The
   cover is 4:3 by default, as on the page; `aspect` makes it square or the image's own shape. #}
{% set product = layout_context.product|default(null) %}
{% set aspect = ({'4:3': null, '1:1': '1-1', 'natural': 'natural'}[data.aspect|default('4:3')] ?? null) %}
{% if product and product.coverUrl %}
<div class="thallo-block thallo-block-product_gallery shop-product__gallery{% if aspect %} shop-product__gallery--{{ aspect }}{% endif %}{{ style_classes('root') }}"{{ style_attrs('root') }} data-shop-gallery>
  {# Sized copies (WebP where the server encodes it); shop.js swaps all three on a thumb click. #}
  {%- set image = product.coverImage ?? null -%}
  {%- set sizes = '(max-width: 48rem) 100vw, 50vw' -%}
  {% if image and image.webp %}<picture class="thallo-picture"><source type="image/webp" srcset="{{ image.webp }}" sizes="{{ sizes }}" data-shop-cover-webp>{% endif -%}
  <img
    class="shop-product__cover{{ style_classes('picture') }}"{{ style_attrs('picture') }}
    src="{{ image.src ?? product.coverUrl }}"
    {%- if image and image.srcset %} srcset="{{ image.srcset }}" sizes="{{ sizes }}"{% endif %}
    alt="{{ product.name }}"
    data-shop-cover
  >
  {%- if image and image.webp %}</picture>{% endif %}
  {% if not (data.hide_thumbnails|default(false)) and product.gallery|length > 1 %}
    <div class="shop-product__thumbs">
      {% for item in product.gallery %}
        <button
          type="button"
          data-shop-thumb
          data-src="{{ item.src ?? item.url }}"
          data-alt="{{ item.alt ?? product.name }}"
          aria-current="{{ loop.first ? 'true' : 'false' }}"
          aria-label="Show image {{ loop.index }} of {{ product.gallery|length }}"
        >
          {% if item.webp ?? null %}<picture class="thallo-picture"><source type="image/webp" srcset="{{ item.webp }}" sizes="3.5rem">{% endif -%}
          <img src="{{ item.src ?? item.url }}"{% if item.srcset ?? null %} srcset="{{ item.srcset }}" sizes="3.5rem"{% endif %} alt="" loading="lazy">
          {%- if item.webp ?? null %}</picture>{% endif %}
        </button>
      {% endfor %}
    </div>
  {% endif %}
</div>
{% elseif product and is_canvas() %}
<div class="thallo-block thallo-block-product_gallery thallo-field-empty">Gallery — this product has no images</div>
{% endif %}
