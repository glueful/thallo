{
    "name": "glueful/thallo-analytics",
    "description": "Product-analytics fact store for Thallo: consumes lifecycle events, owns its own facts, as a removable capability pack.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Tawiah Sowah",
            "email": "michael@glueful.dev"
        }
    ],
    "version": "0.1.0",
    "require": {
        "php": "^8.3",
        "glueful/thallo-contracts": "*",
        "glueful/extension-contracts": "*",
        "glueful/framework": "^1.65.0"
    },
    "autoload": {
        "psr-4": {
            "Thallo\\Analytics\\": "src/"
        }
    },
    "extra": {
        "glueful": {
            "provider": "Thallo\\Analytics\\AnalyticsServiceProvider",
            "requires": {
                "glueful": ">=1.79.0",
                "extensions": []
            },
            "migrations": [
                {
                    "id": "default",
                    "path": "migrations",
                    "priority": "dependent",
                    "mode": "core",
                    "verifier": "Thallo\\Analytics\\Schema\\AnalyticsSchemaVerifier"
                }
            ]
        }
    },
    "minimum-stability": "stable"
}