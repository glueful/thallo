<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         enforceTimeLimit="true"
         defaultTimeLimit="120">
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <!--
            Retrofit harness classes blanket clear process global query interceptors and hooks in
            tearDown, so they MUST run in their OWN phpunit invocation (a teardown clear can never
            then strip interceptors from a following non tenancy class). Invoke separately with
            `phpunit tenancy-retrofit` and THALLO_TENANCY_DEV_LINK=1; the classes skip otherwise,
            so they stay inert in the default Integration run. The shared DB Task 2/3 tests
            (SchemaIntrospectorTest, RetrofitProgressTest) also live here and keep running in the
            default Integration suite unchanged.
        -->
        <testsuite name="tenancy-retrofit">
            <directory>tests/Integration/Tenancy/Retrofit</directory>
            <!-- Pinned MANDATORY acceptance tests live one level up (real widened schema); include them
                 explicitly so the ON regression run of this testsuite exercises them. -->
            <file>tests/Integration/Tenancy/TenantKeyCoexistenceTest.php</file>
            <file>tests/Integration/Tenancy/CrossTenantSchedulerPublishTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="DB_DRIVER" value="pgsql"/>
        <env name="DB_PGSQL_HOST" value="127.0.0.1"/>
        <env name="DB_PGSQL_PORT" value="5432"/>
        <env name="DB_PGSQL_DATABASE" value="app_test"/>
        <env name="DB_PGSQL_USERNAME" value="postgres"/>
        <env name="DB_PGSQL_PASSWORD" value="postgres"/>
        <env name="DB_PGSQL_SCHEMA" value="public"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="RENDER_LISTING_TYPES" value="blog,post"/>
        <env name="RENDER_LISTING_PER_PAGE" value="2"/>
        <env name="CACHE_TAGS" value="false"/>
        <env name="QUERY_CACHE_ENABLED" value="false"/>
        <env name="QUERY_CACHE_STORE" value="array"/>
        <env name="ADMIN_BUNDLE_PATH" value="tests/fixtures/admin"/>
        <env name="PUBLIC_URL_BASE" value="https://site.test"/>
        <env name="RENDER_ADMIN_URL" value="https://admin.test"/>
        <!-- media()/site_logo()/site_favicon() tests need anonymously retrievable
             public blobs; force="true" pins this against ambient .env/CI values. -->
        <env name="UPLOADS_ACCESS" value="public" force="true"/>
        <env name="UPLOADS_ENABLED" value="true" force="true"/>
        <!-- CommerceMetaTest's `can_attach_user` matrix (a closed conjunction of BOTH
             `users.user_lookup` switches and effective `users.view`) asserts the (on, on, *)
             cells against the process-shared boot. Both keys ship OFF by default in
             glueful/users' own config, so those cells silently depended on a developer .env
             that happens to set them — CI generates a .env WITHOUT them, which turned the
             true cell red (shard integration-a) and made the paired false cell pass
             vacuously. force="true" pins the suite's contract against ambient .env/CI values
             in BOTH directions, exactly as the uploads pins above do. -->
        <env name="USERS_USER_LOOKUP_ENABLED" value="true" force="true"/>
        <env name="USERS_USER_LIST_ENABLED" value="true" force="true"/>
    </php>
</phpunit>
