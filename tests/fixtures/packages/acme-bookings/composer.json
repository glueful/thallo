{
    "name": "acme/bookings",
    "description": "A third-party Thallo extension used by the test suite: one activation capability, one block type, one permission, one table.",
    "type": "glueful-extension",
    "version": "1.0.0",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Acme\\Bookings\\": "src/"
        },
        "classmap": [
            "migrations/"
        ]
    },
    "extra": {
        "glueful": {
            "name": "Bookings",
            "provider": "Acme\\Bookings\\BookingsServiceProvider",
            "requires": {
                "glueful": ">=1.79.0",
                "extensions": []
            },
            "migrations": [
                {
                    "id": "default",
                    "path": "migrations",
                    "priority": "dependent",
                    "mode": "on_enable"
                }
            ]
        },
        "thallo": {
            "capabilities": [
                {
                    "id": "acme.bookings",
                    "label": "Bookings",
                    "description": "Appointments your visitors book from your pages.",
                    "mode": "activation",
                    "copy": {
                        "turn_on": "This prepares Bookings and adds its block. Your existing content is kept.",
                        "turn_off": "The Bookings block is hidden. Your bookings are kept, and you can turn it on again.",
                        "links": [
                            {"label": "Block types", "to": "/settings/block-types"}
                        ]
                    }
                }
            ]
        }
    }
}
