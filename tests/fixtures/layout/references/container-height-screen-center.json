{
  "case": "container-height-screen-center",
  "note": "§4 parity: min_height screen with content_align center (the band's inner area owns the space). Container-layout spec §4 parity. width → layout.content_width (contained → width.container, narrow → width.content, full → width.full, each carrying its default gutter); min_height → layout.min_height on root; layout/flex_direction/flex_wrap/align_items/gap → the inner area's display, direction, wrap, align_items and both gaps; justify → alignment.content in flex mode, content_align → alignment.content in block mode, where the old theme made the content area a centred flex column and the new one says so explicitly (spec §3.5).",
  "root": "[data-case-root]",
  "elements": {
    "root": {
      "selector": ".thallo-block-container",
      "profiles": [
        "geometry",
        "spacing",
        "surface"
      ]
    },
    "inner": {
      "selector": ".thallo-block-container__inner",
      "profiles": [
        "geometry",
        "spacing"
      ]
    },
    "heading": {
