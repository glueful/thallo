      "profiles": [
        "geometry",
        "spacing",
        "typography",
        "semantics"
      ]
    },
    "paragraph": {
      "selector": ".thallo-block-container__inner .thallo-block-rich_text p",
      "profiles": [
        "geometry",
        "spacing",
        "typography"
      ]
    }
  },
