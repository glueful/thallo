# The admin SPA *source* lives in the repo for development, but the distribution archive
# (composer create-project / git archive) ships only the compiled bundle (public/admin/, baked
# into release tags). Exclude the source toolchain from the dist tarball.
/admin export-ignore

# Internal engineering record (specs, plans, design history) — repo-only, never in the
# distribution archive. User-facing docs stay at docs/ top level.
/docs/internal export-ignore
# Dogfood-only environment overlay — the everything-on development posture. A distributed
# install must receive the trimmed distribution default in config/extensions.php only.
/config/development export-ignore
