#!/usr/bin/env php
<?php
/**
 * Build the stage fixture of the computed-typography bridge (block typeface plan Task 10): a page
 * rendered in canvas mode by the real render pack — a Links block with a title and a weighted link
 * part, a Container holding another Links block, a Links block with no title, and one with nothing
 * at all (empty-block.spec.js) — written to
 * `tools/runtime-browser/fixtures/typography-bridge/stage.html` (gitignored) with its stylesheets
 * inlined, the page's scripts dropped, and the real preview bridge put back by its repo path.
 * Seeded inside a transaction that is rolled back.
 *
 *   CACHE_DRIVER=array DB_PGSQL_DATABASE=app_test APP_ENV=testing php scripts/build-typography-bridge-fixtures
 */

declare(strict_types=1);

use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Glueful\Database\Connection;
use Thallo\Contracts\Style\BlockStyleRegistry;
use Thallo\Core\Content\Blocks\BlockTypeRepository;
use Thallo\Core\Content\Blocks\StarterBlockTypeSeeder;
use Thallo\Core\Content\Http\Controllers\PreviewController;
use Thallo\Core\Content\Http\DTOs\MintPreviewData;
use Thallo\Core\Content\Repositories\ContentTypeRepository;
use Thallo\Core\Content\Repositories\EntryRepository;
use Thallo\Core\Content\Starter\Kinds\BlockTypeKind;
use Thallo\Core\Tests\Support\TestApplication;
use Thallo\Render\Http\Controllers\RenderController;

require __DIR__ . '/../vendor/autoload.php';
require __DIR__ . '/lib/layout-thumbnails.php';

foreach (getenv() as $key => $value) {
    $_ENV[$key] ??= $value;
}
$_ENV['DB_POOLING_ENABLED'] = 'false';
$root = dirname(__DIR__);
if (is_file($root . '/.env')) {
    Dotenv\Dotenv::createImmutable($root)->safeLoad();
}
$env = static fn (string $key, ?string $default = null): ?string => $_ENV[$key] ?? (getenv($key) === false ? $default : getenv($key));
if ($env('APP_ENV', 'development') !== 'testing') {
    fwrite(STDERR, "Refusing to build outside APP_ENV=testing (it seeds the test database).\n");
    exit(1);
}
$database = (string) $env('DB_PGSQL_DATABASE', '');
if ($database !== 'app_test' && !str_ends_with($database, '_test')) {
    fwrite(STDERR, "Refusing to seed non-test database '{$database}'.\n");
    exit(1);
}

$out = $root . '/tools/runtime-browser/fixtures/typography-bridge';
if (!is_dir($out) && !mkdir($out, 0755, true)) {
    fwrite(STDERR, "cannot create {$out}\n");
    exit(1);
}

$app = TestApplication::instance();
$container = $app->getContainer();
$db = $container->get(Connection::class);

/** Thrown to roll the seeding back once the stage is written. */
final class TypographyBridgeFixtureWritten extends RuntimeException
{
}

$container->get(StarterBlockTypeSeeder::class)->seedMissing();

try {
    $db->transaction(static function () use ($container, $app, $root, $out): void {
        // The shipped starters' style declarations, as the test suite syncs them.
        $blockTypes = $container->get(BlockTypeRepository::class);
        foreach ($container->get(BlockTypeKind::class)->definitions() as $definition) {
            $payload = $definition->payload;
            $row = $blockTypes->findBySlug((string) $payload['slug']);
            if ($row !== null) {
                $blockTypes->updateStyle(
                    (string) $row['uuid'],
                    $payload['style_capabilities'] ?? null,
                    $payload['style_targets'] ?? null,
                    $payload['flags'] ?? null,
                    $row['starter_content'] ?? $payload['starter_content'] ?? null,
                );
            }
        }
        $container->get(BlockStyleRegistry::class)->reset();

        $contentTypes = $container->get(ContentTypeRepository::class);
        $page = $contentTypes->findBySlug('page');
        $pageUuid = $page !== null ? (string) $page['uuid'] : $contentTypes->create([
            'slug' => 'page', 'name' => 'Page', 'schema' => [
                ['name' => 'title', 'type' => 'string'],
                ['name' => 'body', 'type' => 'blocks'],
            ],
        ]);
        $page = $contentTypes->findByUuid($pageUuid);
        $entries = $container->get(EntryRepository::class);
        $entryUuid = $entries->createEntry($pageUuid, 'en', (int) $page['schema_version'], null);
        $draft = $entries->findDraft($entryUuid, 'en');
        $choice = static fn (string $value): array => ['type' => 'choice', 'value' => $value];
        $links = static fn (string $id, ?string $title, array $settings = []): array => [
            'id' => $id, 'type' => 'links', 'settings' => $settings, 'data' => ['title' => $title, 'items' => [
                ['label' => 'One', 'url' => '/one'],
                ['label' => 'Two', 'url' => '/two'],
            ]],
        ];
        $entries->saveDraft($entryUuid, 'en', ['title' => 'Typography bridge', 'body' => [
            // A title and a link part in different weights, so a reply says which element it read.
            $links('linksweight1', 'Explore', [
                'style' => ['typography' => ['weight' => ['base' => $choice('medium')]]],
                'parts' => ['link' => ['typography' => ['weight' => ['base' => $choice('bold')]]]],
            ]),
            ['id' => 'container001', 'type' => 'container', 'settings' => [], 'data' => ['element' => 'div',
                'content' => [$links('linksnested1', 'Nested', [
                    'style' => ['typography' => ['weight' => ['base' => $choice('semibold')]]],
                ])]]],
            $links('linksnotitle', null),
            // A Links block with neither title nor links: it paints nothing, so the stage stubs it
            // (empty-block.spec.js), and must keep the stub however often the bridge re-checks.
            ['id' => 'linksempty01', 'type' => 'links', 'settings' => [], 'data' => ['title' => null, 'items' => []]],
        ]], (int) $page['schema_version'], (int) ($draft['lock_version'] ?? 0), null);

        $mint = $container->get(PreviewController::class)->mint(
            new MintPreviewData(),
            Request::create('/x', 'POST', [], [], [], ['CONTENT_TYPE' => 'application/json'], '{}'),
            $entryUuid,
            'en',
        );
        $token = (string) (json_decode((string) $mint->getContent(), true)['data']['token'] ?? '');
        if ($token === '') {
            throw new RuntimeException('mint returned no token');
        }
        $rendered = $container->get(RenderController::class)->preview(
            Request::create('/_preview/' . $token . '?canvas=1', 'GET'),
            $token,
        );
        if ($rendered->getStatusCode() !== 200) {
            throw new RuntimeException("the stage returned {$rendered->getStatusCode()}");
        }
        $html = layout_self_contained(
            (string) $rendered->getContent(),
            static fn (Request $request): Response => $app->handle($request),
            [],
            $root,
        );
        // The real bridge, served from the repo by the runtime-browser server.
        $bridge = '<script src="/packages/thallo-render/assets/preview/preview-bridge.js"></script>';
        $html = preg_replace('~</body\s*>~i', $bridge . '</body>', $html, 1, $count);
        if ($count !== 1) {
            throw new RuntimeException('the stage has no </body>');
        }
        file_put_contents($out . '/stage.html', $html);
        throw new TypographyBridgeFixtureWritten();
    });
} catch (TypographyBridgeFixtureWritten) {
    // Written, and rolled back.
} catch (Throwable $e) {
    fwrite(STDERR, 'the typography bridge fixture failed: ' . $e::class . ': ' . $e->getMessage() . "\n");
    exit(1);
}

fwrite(STDOUT, "Wrote stage.html to tools/runtime-browser/fixtures/typography-bridge.\n");
