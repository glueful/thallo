#!/usr/bin/env php
<?php
/**
 * Build the fixtures of the hover state (hover state spec §4.1, §4.3): one page — Buttons of every
 * variant untouched and with one authored hover property, a Button whose hover reset beats its style
 * class, Links, File and Social links blocks untouched and with hover values, and a Navigation whose
 * Menu item section has a hover background and whose Current page section is the pill — rendered by the real
 * render pack twice, published (`public.html`) and on the editor's canvas stage (`stage.html`), into
 * `tools/runtime-browser/fixtures/hover/` (gitignored) with stylesheets inlined and scripts dropped.
 * Seeded inside a transaction that is rolled back. Read by hover.spec.js.
 *
 *   CACHE_DRIVER=array DB_PGSQL_DATABASE=app_test APP_ENV=testing php scripts/build-hover-fixtures
 */

declare(strict_types=1);

use Glueful\Bootstrap\ApplicationContext;
use Glueful\Database\Connection;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Thallo\Contracts\Style\BlockStyleRegistry;
use Thallo\Contracts\Style\StyleClassProvider;
use Thallo\Core\Content\Blocks\BlockTypeRepository;
use Thallo\Core\Content\Blocks\StarterBlockTypeSeeder;
use Thallo\Core\Content\Http\Controllers\PreviewController;
use Thallo\Core\Content\Http\DTOs\MintPreviewData;
use Thallo\Core\Content\Repositories\ContentTypeRepository;
use Thallo\Core\Content\Starter\Kinds\BlockTypeKind;
use Thallo\Core\Tests\Support\ListingPageSeed;
use Thallo\Core\Tests\Support\TestApplication;
use Thallo\Render\Http\Controllers\RenderController;

require __DIR__ . '/../vendor/autoload.php';
require __DIR__ . '/lib/layout-thumbnails.php';

foreach (getenv() as $key => $value) {
    $_ENV[$key] ??= $value;
}
$_ENV['DB_POOLING_ENABLED'] = 'false';
$root = dirname(__DIR__);
if (is_file($root . '/.env')) {
    Dotenv\Dotenv::createImmutable($root)->safeLoad();
}
$env = static fn (string $key, ?string $default = null): ?string => $_ENV[$key] ?? (getenv($key) === false ? $default : getenv($key));
if ($env('APP_ENV', 'development') !== 'testing') {
    fwrite(STDERR, "Refusing to build outside APP_ENV=testing (it seeds the test database).\n");
    exit(1);
}
$database = (string) $env('DB_PGSQL_DATABASE', '');
if ($database !== 'app_test' && !str_ends_with($database, '_test')) {
    fwrite(STDERR, "Refusing to seed non-test database '{$database}'.\n");
    exit(1);
}

$out = $root . '/tools/runtime-browser/fixtures/hover';
if (!is_dir($out) && !mkdir($out, 0755, true)) {
    fwrite(STDERR, "cannot create {$out}\n");
    exit(1);
}

$app = TestApplication::instance();
$container = $app->getContainer();
$context = $container->get(ApplicationContext::class);
$db = $container->get(Connection::class);

/** The page as a self-contained document: stylesheets and fonts inlined, scripts dropped. */
$selfContained = static fn (string $html): string => layout_self_contained(
    $html,
    static fn (Request $request): Response => $app->handle($request),
    ListingPageSeed::IMAGES,
    $root,
);

/** Thrown to roll the seeding back once the pages are written. */
final class HoverFixturesWritten extends RuntimeException
{
}

$container->get(StarterBlockTypeSeeder::class)->seedMissing();

try {
    $db->transaction(static function () use ($container, $context, $db, $app, $selfContained, $out): void {
        // The shipped starters' style declarations, as the test suite syncs them.
        $blockTypes = $container->get(BlockTypeRepository::class);
        foreach ($container->get(BlockTypeKind::class)->definitions() as $definition) {
            $payload = $definition->payload;
            $row = $blockTypes->findBySlug((string) $payload['slug']);
            if ($row !== null) {
                $blockTypes->updateStyle(
                    (string) $row['uuid'],
                    $payload['style_capabilities'] ?? null,
                    $payload['style_targets'] ?? null,
                    $payload['flags'] ?? null,
                    $row['starter_content'] ?? $payload['starter_content'] ?? null,
                );
            }
        }
        $container->get(BlockStyleRegistry::class)->reset();

        // A public blob for the File blocks to link to: the listing seed's images.
        $disk = (string) config($context, 'thallo.media_disk', 'local');
        foreach (ListingPageSeed::IMAGES as $blob => $file) {
            $db->table('blobs')->insert([
                'uuid' => $blob, 'name' => basename($file), 'mime_type' => 'image/png', 'size' => 1,
                'url' => 'uploads/' . basename($file), 'visibility' => 'public', 'status' => 'active',
                'storage_type' => $disk, 'created_by' => 'user00000001', 'created_at' => '2026-07-01 00:00:00',
            ]);
        }

        // A style class giving a hover background; the Button wearing it resets that hover value.
        $db->table('style_classes')->insert([
            'id' => 'hoverclass01', 'name' => 'Hover accent', 'name_key' => 'hover-accent', 'version' => 1,
            'style' => json_encode(['hover' => ['colors' => ['surface' => ['type' => 'token', 'value' => 'color.accent']]]]),
            'created_at' => gmdate('Y-m-d H:i:s'), 'updated_at' => gmdate('Y-m-d H:i:s'),
        ]);
        $container->get(StyleClassProvider::class)->refresh();

        $token = static fn (string $value): array => ['type' => 'token', 'value' => $value];
        $accent = $token('color.accent');
        $button = static fn (string $id, string $variant, array $settings = []): array => [
            'id' => $id, 'type' => 'button',
            'data' => ['label' => 'Read more', 'url' => '/more', 'variant' => $variant],
            'settings' => $settings,
        ];
        $links = static fn (string $id, array $settings = []): array => [
            'id' => $id, 'type' => 'links', 'data' => ['title' => 'Explore', 'items' => [
                ['label' => 'One', 'url' => '/one'],
                ['label' => 'Two', 'url' => '/two'],
            ]],
            'settings' => $settings,
        ];
        $file = static fn (string $id, array $settings = []): array => [
            'id' => $id, 'type' => 'file',
            'data' => ['file' => array_key_first(ListingPageSeed::IMAGES), 'label' => 'Download the guide'],
            'settings' => $settings,
        ];
        $socials = static fn (string $id, array $row = [], array $xSettings = []): array => [
            'id' => $id, 'type' => 'social_links',
            'data' => ['items' => [
                ['id' => $id . 'ig', 'type' => 'social_link', 'data' => ['icon' => 'brand:instagram', 'url' => 'https://example.com/ig'], 'settings' => []],
                ['id' => $id . 'x1', 'type' => 'social_link', 'data' => ['icon' => 'brand:x', 'url' => 'https://example.com/x'], 'settings' => $xSettings],
            ]],
            'settings' => $row,
        ];
        $variants = ['solid', 'outline', 'soft', 'subtle', 'ghost', 'link'];
        $body = [];
        // Every variant untouched: the theme's hover look alone.
        foreach ($variants as $variant) {
            $body[] = $button(str_pad('btnplain' . $variant, 12, '0'), $variant);
        }
        // Every variant with one authored hover property (the text colour) and nothing else.
        foreach ($variants as $variant) {
            $body[] = $button(str_pad('btnhov' . $variant, 12, '0'), $variant, ['style' => ['hover' => ['colors' => ['text' => $accent]]]]);
        }
        // A resting background, and a hover reset over a style class's hover background.
        $body[] = $button('btnreset0001', 'solid', [
            'classes' => ['hoverclass01'],
            'style' => ['colors' => ['surface' => $token('color.black')], 'hover' => ['colors' => ['surface' => ['type' => 'reset']]]],
        ]);
        $body[] = $links('linksplain01');
        $body[] = $links('linkshover01', ['parts' => ['link' => ['hover' => ['colors' => ['text' => $accent]]]]]);
        $body[] = $file('fileplain001');
        $body[] = $file('filehovtext1', ['parts' => ['link' => ['hover' => ['colors' => ['text' => $accent]]]]]);
        $body[] = $file('filehovbg001', ['parts' => ['link' => ['hover' => ['colors' => ['surface' => $accent]]]]]);
        $body[] = $socials('socialplain1');
        $body[] = $socials('socialhovbg1', ['parts' => ['icon' => ['hover' => ['colors' => ['surface' => $accent]]]]]);
        // A muted icon that turns accent; the second link resets its hover colour.
        $body[] = $socials(
            'socialhover1',
            ['parts' => ['icon' => ['colors' => ['text' => $token('color.muted')], 'hover' => ['colors' => ['text' => $accent]]]]],
            ['parts' => ['icon' => ['hover' => ['colors' => ['text' => ['type' => 'reset']]]]]],
        );

        // A Navigation over a menu whose first item is this page: every item turns accent under the
        // pointer, and the current page is a black pill that stays black.
        $menus = $container->get(\Thallo\Navigation\MenuRepository::class);
        $menu = $menus->createMenu('hovernav', 'Hover nav');
        $item = static fn (string $uuid, int $position, string $url, string $label): array => [
            'uuid' => $uuid, 'parent_uuid' => null, 'position' => $position, 'kind' => 'url',
            'entry_uuid' => null, 'url' => $url, 'labels' => json_encode(['en' => $label]),
            'created_at' => gmdate('Y-m-d H:i:s'), 'updated_at' => gmdate('Y-m-d H:i:s'),
        ];
        // Written as replaceTree() writes them: it opens a transaction of its own, and this is one.
        foreach ([$item('hovernavit01', 0, '/landing/hover', 'Here'), $item('hovernavit02', 1, '/elsewhere', 'Elsewhere')] as $row) {
            $db->table('navigation_items')->insert($row + ['menu_uuid' => (string) $menu['uuid']]);
        }
        $body[] = ['id' => 'hovernav0001', 'type' => 'navigation', 'data' => ['menu' => 'hovernav'], 'settings' => [
            'parts' => [
                'item' => ['hover' => ['colors' => ['surface' => $accent]]],
                'current' => ['colors' => ['surface' => $token('color.black'), 'text' => $token('color.white')]],
            ],
        ]];

        $type = (string) $container->get(ContentTypeRepository::class)->create([
            'slug' => 'landing', 'name' => 'Landing pages', 'public_delivery' => true, 'schema' => [
                ['name' => 'title', 'type' => 'string', 'required' => true],
                ['name' => 'body', 'type' => 'blocks'],
            ],
        ]);
        $entry = (new ListingPageSeed($container, $context))
            ->publish($type, 'hover', ['title' => 'Hover', 'body' => $body], '2026-07-01 09:00:00');

        // Published: what a visitor receives.
        $public = $app->handle(Request::create('/landing/hover', 'GET'));
        if ($public->getStatusCode() !== 200) {
            throw new RuntimeException("/landing/hover answered {$public->getStatusCode()}");
        }
        file_put_contents($out . '/public.html', $selfContained((string) $public->getContent()));

        // The canvas stage the editor frames, from the same entry.
        $mint = $container->get(PreviewController::class)->mint(
            new MintPreviewData(),
            Request::create('/x', 'POST', [], [], [], ['CONTENT_TYPE' => 'application/json'], '{}'),
            $entry,
            'en',
        );
        $token = (string) (json_decode((string) $mint->getContent(), true)['data']['token'] ?? '');
        if ($token === '') {
            throw new RuntimeException('mint returned no token');
        }
        $stage = $container->get(RenderController::class)->preview(
            Request::create('/_preview/' . $token . '?canvas=1', 'GET'),
            $token,
        );
        if ($stage->getStatusCode() !== 200) {
            throw new RuntimeException("the stage returned {$stage->getStatusCode()}");
        }
        file_put_contents($out . '/stage.html', $selfContained((string) $stage->getContent()));

        throw new HoverFixturesWritten();
    });
} catch (HoverFixturesWritten) {
    // Written, and rolled back.
} catch (Throwable $e) {
    $detail = $e instanceof \Thallo\Core\Content\Validation\ValidationException ? ' ' . json_encode($e->errors()) : '';
    fwrite(STDERR, 'the hover fixtures failed: ' . $e::class . ': ' . $e->getMessage() . $detail . "\n");
    exit(1);
}

fwrite(STDOUT, "Wrote public.html, stage.html to tools/runtime-browser/fixtures/hover.\n");
