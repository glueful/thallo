#!/usr/bin/env php
<?php
/**
 * Build the real-browser shop home and category fixtures (type layouts plan C2, S0 and S6): the shop
 * of {@see ShopPageSeed}, seeded with fixed values inside a transaction that is rolled back, rendered
 * through the real shop controller into `tools/runtime-browser/fixtures/shop-layout/` (gitignored).
 * Every stylesheet, font and image a page references is fetched through the application and inlined,
 * and scripts are dropped, so a page measures the same wherever it is opened.
 *
 * Pages: `shop-index-original.html` and `shop-category-original.html` — today's shop home and the
 * Mugs category (`shop/index.twig`, `shop/category.twig`), the pages `references/shop-*-original.json`
 * froze before any C2 template or stylesheet change. Then, for the shop home and the category pages
 * alike (`shop-{index,category}-{state}.html`, each also as its layout stage, `*-stage.html`):
 * `starter` — the layouts' starter saved; `authored` — values set on the title's heading, the card's
 * name and price and the Product list's cards; `reset` — those values removed again; `flex` — the
 * cards on a flex row; `class-three` — a style class giving the cards three columns;
 * `class-reset` — that class with an explicit reset of the columns on the block; and
 * `after-remove` — the `class-three` layout removed (the public page is the theme's again; the
 * stage is the fresh session's starter). Last, the long-name shop (`ShopPageSeed::longNames()`):
 * `long-names-original.html`, `long-names.html` and `long-names-stage.html`.
 *
 *   CACHE_DRIVER=array DB_PGSQL_DATABASE=app_test APP_ENV=testing php scripts/build-shop-layout-proof-fixtures
 */

declare(strict_types=1);

use Glueful\Bootstrap\ApplicationContext;
use Glueful\Database\Connection;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Glueful\Validation\RequestDataHydrator;
use Thallo\Contracts\Layouts\LayoutSurfaceRegistry;
use Thallo\Core\Content\Blocks\BlockTypeRepository;
use Thallo\Core\Content\Layouts\LayoutResolver;
use Thallo\Core\Content\Style\Classes\StyleClassRepository;
use Thallo\Core\Http\Controllers\LayoutAdminController;
use Thallo\Core\Http\Controllers\LayoutPreviewController;
use Thallo\Core\Http\DTOs\LayoutSessionData;
use Thallo\Core\Http\DTOs\RemoveLayoutData;
use Thallo\Core\Http\DTOs\SaveLayoutData;
use Thallo\Core\Content\Blocks\StarterBlockTypeSeeder;
use Thallo\Core\Content\Starter\Kinds\BlockTypeKind;
use Thallo\Core\Tests\Support\ShopPageSeed;
use Thallo\Core\Tests\Support\TestApplication;

require __DIR__ . '/../vendor/autoload.php';

foreach (getenv() as $key => $value) {
    $_ENV[$key] ??= $value;
}
$_ENV['DB_POOLING_ENABLED'] = 'false';
$root = dirname(__DIR__);
if (is_file($root . '/.env')) {
    Dotenv\Dotenv::createImmutable($root)->safeLoad();
}
$env = static fn (string $key, ?string $default = null): ?string => $_ENV[$key] ?? (getenv($key) === false ? $default : getenv($key));
if ($env('APP_ENV', 'development') !== 'testing') {
    fwrite(STDERR, "Refusing to build outside APP_ENV=testing (it seeds the test database).\n");
    exit(1);
}
$database = (string) $env('DB_PGSQL_DATABASE', '');
if ($database !== 'app_test' && !str_ends_with($database, '_test')) {
    fwrite(STDERR, "Refusing to seed non-test database '{$database}'.\n");
    exit(1);
}

$out = $root . '/tools/runtime-browser/fixtures/shop-layout';
if (!is_dir($out) && !mkdir($out, 0755, true)) {
    fwrite(STDERR, "cannot create {$out}\n");
    exit(1);
}

$app = TestApplication::instance();
$container = $app->getContainer();
$context = $container->get(ApplicationContext::class);
$db = $container->get(Connection::class);
$seed = new ShopPageSeed($container, $context);

/** A GET through the application, following its redirects (the shop stylesheet alias 302s). */
$get = static function (string $path) use ($app): Response {
    for ($hop = 0; $hop < 4; $hop++) {
        $response = $app->handle(Request::create($path, 'GET'));
        if (!$response->isRedirection()) {
            return $response;
        }
        $path = (string) $response->headers->get('Location');
    }
    throw new RuntimeException("too many redirects for {$path}");
};

$dataUri = static fn (string $mime, string $bytes): string => 'data:' . $mime . ';base64,' . base64_encode($bytes);

/** Inline every `url(...)` a stylesheet names, resolved against the stylesheet's own path. */
$inlineUrls = static function (string $css, string $base) use ($get, $dataUri): string {
    return (string) preg_replace_callback(
        '~url\(\s*(["\']?)([^"\')]+)\1\s*\)~',
        static function (array $m) use ($get, $dataUri, $base): string {
            $url = $m[2];
            if (str_starts_with($url, 'data:') || str_starts_with($url, '#')) {
                return $m[0];
            }
            $path = str_starts_with($url, '/') ? $url : rtrim(dirname($base), '/') . '/' . $url;
            $asset = $get($path);
            if ($asset->getStatusCode() !== 200) {
                throw new RuntimeException("cannot inline {$path}: {$asset->getStatusCode()}");
            }
            $mime = strtok((string) $asset->headers->get('Content-Type', 'application/octet-stream'), ';');
            return 'url("' . $dataUri((string) $mime, (string) $asset->getContent()) . '")';
        },
        $css,
    );
};

/** The page as a self-contained document: stylesheets, fonts and images inlined, scripts dropped. */
$selfContained = static function (string $html) use ($get, $inlineUrls, $dataUri, $root): string {
    $html = (string) preg_replace_callback(
        '~<link rel="stylesheet" href="([^"]+)">~',
        static function (array $m) use ($get, $inlineUrls): string {
            $href = html_entity_decode($m[1]);
            $sheet = $get($href);
            if ($sheet->getStatusCode() !== 200) {
                throw new RuntimeException("cannot inline stylesheet {$href}: {$sheet->getStatusCode()}");
            }
            return '<style data-inlined="' . htmlspecialchars($href) . '">'
                . $inlineUrls((string) $sheet->getContent(), (string) parse_url($href, PHP_URL_PATH)) . '</style>';
        },
        $html,
    );
    $html = (string) preg_replace_callback(
        '~<style([^>]*)>(.*?)</style>~s',
        static fn (array $m): string => '<style' . $m[1] . '>' . $inlineUrls($m[2], '/') . '</style>',
        $html,
    );
    foreach (ShopPageSeed::IMAGES as $blob => $file) {
        $html = (string) preg_replace(
            '~(src|data-src)="[^"]*/blobs/' . $blob . '[^"]*"~',
            '$1="' . $dataUri('image/png', (string) file_get_contents($root . '/' . $file)) . '"',
            $html,
        );
    }
    $html = (string) preg_replace('~<script\b[^>]*>.*?</script>~s', '', $html);
    return (string) preg_replace('~<link rel="(preload|modulepreload|icon)"[^>]*>~', '', $html);
};

/** Thrown to roll the seeding back once the pages are written. */
final class ShopFixturesWritten extends RuntimeException
{
}

// The block types' style declarations, as the application syncs them.
$container->get(StarterBlockTypeSeeder::class)->seedMissing();
$blockTypes = $container->get(BlockTypeRepository::class);
foreach ($container->get(BlockTypeKind::class)->definitions() as $definition) {
    $payload = $definition->payload;
    $row = $blockTypes->findBySlug((string) $payload['slug']);
    if ($row !== null) {
        $blockTypes->updateStyle(
            (string) $row['uuid'],
            $payload['style_capabilities'] ?? null,
            $payload['style_targets'] ?? null,
            $payload['flags'] ?? null,
            $row['starter_content'] ?? $payload['starter_content'] ?? null,
        );
    }
}

$previous = $seed->useTenant();
$written = [];
try {
    $db->transaction(static function () use ($container, $seed, $get, $selfContained, $out, &$written): void {
        // Rows a test left behind would change the listing; they come back with the rollback.
        $seed->clear();
        $seed->seed();

        // A foreign query parameter keeps the shop page cache out of the way (it bypasses it).
        $pages = [
            'shop-index-original' => ['/shop?proof=1', ['shop-titlerow', 'shop-rail', 'shop-grid__item', 'pagination']],
            'shop-category-original' => ['/shop/categories/mugs?proof=1', ['shop-titlerow', 'shop-rail__chip--active', 'shop-grid__item']],
        ];
        foreach ($pages as $name => [$path, $parts]) {
            $page = $get($path);
            if ($page->getStatusCode() !== 200) {
                throw new RuntimeException("{$path} answered {$page->getStatusCode()}");
            }
            $html = (string) $page->getContent();
            foreach ($parts as $part) {
                if (!str_contains($html, $part)) {
                    throw new RuntimeException("{$path} has no {$part}: the seed is incomplete");
                }
            }
            file_put_contents($out . "/{$name}.html", $selfContained($html));
            $written[] = "{$name}.html";
        }

        // The shop layouts, saved through a session and Save as the editor saves them, then the page
        // and the stage of that session rendered for each state.
        $hydrator = new RequestDataHydrator();
        $withIds = static function (array $tree, string $prefix) use (&$withIds): array {
            foreach ($tree as $i => $block) {
                $tree[$i]['id'] = str_pad($prefix . $i, 12, '0');
                foreach ($block['data'] as $key => $value) {
                    if (is_array($value) && array_is_list($value) && isset($value[0]['type'])) {
                        $tree[$i]['data'][$key] = $withIds($value, $prefix . $i . 'n');
                    }
                }
            }
            return $tree;
        };
        $token = static fn (string $value): array => ['base' => ['type' => 'token', 'value' => $value]];
        $choice = static fn (string $value): array => ['base' => ['type' => 'choice', 'value' => $value]];
        /** Set `$settings` on every block of `$type` in the tree. */
        $styled = static function (array $tree, array $by) use (&$styled): array {
            foreach ($tree as $i => $block) {
                if (isset($by[$block['type']])) {
                    $tree[$i]['settings'] = $by[$block['type']];
                }
                foreach ($block['data'] as $key => $value) {
                    if (is_array($value) && array_is_list($value) && isset($value[0]['type'])) {
                        $tree[$i]['data'][$key] = $styled($value, $by);
                    }
                }
            }
            return $tree;
        };
        $threeCols = $container->get(StyleClassRepository::class)->create([
            'name' => 'Three columns',
            'style' => [
                'layout' => ['display' => $choice('grid'), 'columns' => $choice('3')],
                'spacing' => ['margin' => ['top' => $token('spacing.lg')]],
            ],
        ]);
        $session = static function (string $surface) use ($container, $hydrator): array {
            return json_decode((string) $container->get(LayoutPreviewController::class)->session(
                $hydrator->hydrate(LayoutSessionData::class, ['surface' => $surface, 'target' => '@site']),
            )->getContent(), true)['data'];
        };
        $surfaces = ['index' => ['shop_index', '/shop?proof=1'], 'category' => ['shop_category', '/shop/categories/mugs?proof=1']];
        foreach ($surfaces as $page => [$surface, $path]) {
            $starter = $withIds($container->get(LayoutSurfaceRegistry::class)->get($surface)->starter('@site'), 's');
            $loopReset = ['base' => ['type' => 'reset'], 'md' => ['type' => 'reset'], 'lg' => ['type' => 'reset']];
            $states = [
                'starter' => $starter,
                'authored' => $styled($starter, [
                    'shop_title' => ['style' => [
                        'spacing' => ['margin' => ['top' => $token('spacing.lg')]],
                        'typography' => ['size' => $token('typography.size.3xl')],
                        'colors' => ['text' => ['type' => 'token', 'value' => 'color.accent']],
                    ]],
                    'product_name' => ['style' => ['typography' => ['size' => $token('typography.size.lg')]]],
                    'product_price' => ['style' => ['colors' => ['text' => ['type' => 'token', 'value' => 'color.muted']]]],
                    'product_loop' => ['style' => ['spacing' => ['margin' => ['bottom' => $token('spacing.xl')]], 'layout' => [
                        'display' => $choice('grid'),
                        'columns' => ['base' => ['type' => 'choice', 'value' => '1'], 'md' => ['type' => 'choice', 'value' => '3']],
                        'gap' => ['column' => $token('spacing.lg'), 'row' => $token('spacing.lg')],
                    ]]],
                ]),
                'reset' => $starter,
                'flex' => $styled($starter, ['product_loop' => ['style' => ['layout' => [
                    'display' => $choice('flex'), 'direction' => $choice('row'), 'wrap' => $choice('wrap'),
                ]]]]),
                'class-three' => $styled($starter, ['product_loop' => ['classes' => [$threeCols['id']]]]),
                'class-reset' => $styled($starter, ['product_loop' => [
                    'classes' => [$threeCols['id']],
                    'style' => ['layout' => ['columns' => $loopReset]],
                ]]),
            ];
            $version = 0;
            foreach ($states as $name => $blocks) {
                $saved = $container->get(LayoutAdminController::class)->save(
                    $hydrator->hydrate(SaveLayoutData::class, [
                        'token' => $session($surface)['token'], 'layout' => ['blocks' => $blocks, 'settings' => []],
                        'expected_lock_version' => $version,
                    ]),
                    Request::create('/x', 'PUT'),
                    $surface,
                    '@site',
                );
                if ($saved->getStatusCode() !== 200) {
                    throw new RuntimeException("saving the {$page} {$name} layout answered {$saved->getStatusCode()}: {$saved->getContent()}");
                }
                $version++;
                // Inside this rolled-back transaction Save's effects wait for a commit that never
                // comes: forget the resolver's answer here, and render the stage from a session
                // minted now, whose baseline is the layout just saved.
                $container->get(LayoutResolver::class)->forget($surface, '@site');
                $stage = $session($surface);
                foreach (['' => $path, '-stage' => '/_preview/' . $stage['token'] . '?canvas=1'] as $suffix => $url) {
                    $rendered = $get($url);
                    if ($rendered->getStatusCode() !== 200 || !str_contains((string) $rendered->getContent(), "shop-{$page}--layout")) {
                        throw new RuntimeException("the {$page} {$name}{$suffix} page is not the shop frame ({$rendered->getStatusCode()})");
                    }
                    file_put_contents($out . "/shop-{$page}-{$name}{$suffix}.html", $selfContained((string) $rendered->getContent()));
                    $written[] = "shop-{$page}-{$name}{$suffix}.html";
                }
            }
            // Removed: the public page is the theme's again, and a fresh session opens on the starter.
            $removing = $session($surface);
            $removed = $container->get(LayoutAdminController::class)->destroy(
                $hydrator->hydrate(RemoveLayoutData::class, [
                    'token' => $removing['token'], 'expected_lock_version' => $version,
                ]),
                Request::create('/x', 'DELETE'),
                $surface,
                '@site',
            );
            if ($removed->getStatusCode() !== 200) {
                throw new RuntimeException("removing the {$page} layout answered {$removed->getStatusCode()}: {$removed->getContent()}");
            }
            $container->get(LayoutResolver::class)->forget($surface, '@site');
            $theme = (string) $get($path)->getContent();
            if (str_contains($theme, "shop-{$page}--layout")) {
                throw new RuntimeException("the {$page} page still renders a layout after the removal");
            }
            file_put_contents($out . "/shop-{$page}-after-remove.html", $selfContained($theme));
            $fresh = $session($surface);
            $stageHtml = (string) $get('/_preview/' . $fresh['token'] . '?canvas=1')->getContent();
            file_put_contents($out . "/shop-{$page}-after-remove-stage.html", $selfContained($stageHtml));
            $written[] = "shop-{$page}-after-remove.html";
            $written[] = "shop-{$page}-after-remove-stage.html";
        }

        // The long-name shop: today's page, and the starter on the page and the stage.
        $seed->clear();
        $seed->longNames();
        file_put_contents($out . '/long-names-original.html', $selfContained((string) $get('/shop?proof=1')->getContent()));
        $starter = $withIds($container->get(LayoutSurfaceRegistry::class)->get('shop_index')->starter('@site'), 'l');
        $saved = $container->get(LayoutAdminController::class)->save(
            $hydrator->hydrate(SaveLayoutData::class, [
                'token' => $session('shop_index')['token'], 'layout' => ['blocks' => $starter, 'settings' => []],
                'expected_lock_version' => $container->get(Thallo\Core\Content\Layouts\LayoutRepository::class)
                    ->version('shop_index', '@site'),
            ]),
            Request::create('/x', 'PUT'),
            'shop_index',
            '@site',
        );
        if ($saved->getStatusCode() !== 200) {
            throw new RuntimeException("saving the long-name layout answered {$saved->getStatusCode()}: {$saved->getContent()}");
        }
        $container->get(LayoutResolver::class)->forget('shop_index', '@site');
        file_put_contents($out . '/long-names.html', $selfContained((string) $get('/shop?proof=1')->getContent()));
        $stage = $session('shop_index');
        file_put_contents(
            $out . '/long-names-stage.html',
            $selfContained((string) $get('/_preview/' . $stage['token'] . '?canvas=1')->getContent()),
        );
        array_push($written, 'long-names-original.html', 'long-names.html', 'long-names-stage.html');

        throw new ShopFixturesWritten();
    });
} catch (ShopFixturesWritten) {
    // Written, and rolled back.
} catch (Throwable $e) {
    // Left to the framework's handler, a throw prints its JSON and exits 0. (exit() skips the
    // finally below, so the tenant flags are put back here first.)
    $seed->restoreTenant($previous);
    fwrite(STDERR, 'the shop fixtures failed: ' . $e::class . ': ' . $e->getMessage() . "\n");
    exit(1);
} finally {
    $seed->restoreTenant($previous);
}

fwrite(STDOUT, 'Wrote ' . implode(', ', $written) . " to tools/runtime-browser/fixtures/shop-layout.\n");
