#!/usr/bin/env php
<?php
/**
 * Build the fixtures of letter spacing, text transform and text decoration (settings version 12):
 * one page — Headings, Links and link-variant Buttons, each setting against an untouched control,
 * a Heading whose style class it overrides, a Separator coloured and with a styled label, and
 * Logos blocks sized per width with their gaps set (one scrolling, one width-capped) — rendered by the real render pack twice, published
 * (`public.html`) and on the editor's canvas stage (`stage.html`), into
 * `tools/runtime-browser/fixtures/text-style/` (gitignored) with stylesheets inlined and scripts
 * dropped. Seeded inside a transaction that is rolled back. Read by text-style.spec.js.
 *
 *   CACHE_DRIVER=array DB_PGSQL_DATABASE=app_test APP_ENV=testing php scripts/build-text-style-fixtures
 */

declare(strict_types=1);

use Glueful\Bootstrap\ApplicationContext;
use Glueful\Database\Connection;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Thallo\Contracts\Style\BlockStyleRegistry;
use Thallo\Contracts\Style\StyleClassProvider;
use Thallo\Core\Content\Blocks\BlockTypeRepository;
use Thallo\Core\Content\Blocks\StarterBlockTypeSeeder;
use Thallo\Core\Content\Http\Controllers\PreviewController;
use Thallo\Core\Content\Http\DTOs\MintPreviewData;
use Thallo\Core\Content\Repositories\ContentTypeRepository;
use Thallo\Core\Content\Starter\Kinds\BlockTypeKind;
use Thallo\Core\Tests\Support\ListingPageSeed;
use Thallo\Core\Tests\Support\TestApplication;
use Thallo\Render\Http\Controllers\RenderController;

require __DIR__ . '/../vendor/autoload.php';
require __DIR__ . '/lib/layout-thumbnails.php';

foreach (getenv() as $key => $value) {
    $_ENV[$key] ??= $value;
}
$_ENV['DB_POOLING_ENABLED'] = 'false';
$root = dirname(__DIR__);
if (is_file($root . '/.env')) {
    Dotenv\Dotenv::createImmutable($root)->safeLoad();
}
$env = static fn (string $key, ?string $default = null): ?string => $_ENV[$key] ?? (getenv($key) === false ? $default : getenv($key));
if ($env('APP_ENV', 'development') !== 'testing') {
    fwrite(STDERR, "Refusing to build outside APP_ENV=testing (it seeds the test database).\n");
    exit(1);
}
$database = (string) $env('DB_PGSQL_DATABASE', '');
if ($database !== 'app_test' && !str_ends_with($database, '_test')) {
    fwrite(STDERR, "Refusing to seed non-test database '{$database}'.\n");
    exit(1);
}

$out = $root . '/tools/runtime-browser/fixtures/text-style';
if (!is_dir($out) && !mkdir($out, 0755, true)) {
    fwrite(STDERR, "cannot create {$out}\n");
    exit(1);
}

$app = TestApplication::instance();
$container = $app->getContainer();
$context = $container->get(ApplicationContext::class);
$db = $container->get(Connection::class);

/** The page as a self-contained document: stylesheets and fonts inlined, scripts dropped. */
$selfContained = static fn (string $html): string => layout_self_contained(
    $html,
    static fn (Request $request): Response => $app->handle($request),
    ListingPageSeed::IMAGES,
    $root,
);

/** Thrown to roll the seeding back once the pages are written. */
final class TextStyleFixturesWritten extends RuntimeException
{
}

$container->get(StarterBlockTypeSeeder::class)->seedMissing();

try {
    $db->transaction(static function () use ($container, $context, $db, $app, $selfContained, $out): void {
        // The shipped starters' style declarations, as the test suite syncs them.
        $blockTypes = $container->get(BlockTypeRepository::class);
        foreach ($container->get(BlockTypeKind::class)->definitions() as $definition) {
            $payload = $definition->payload;
            $row = $blockTypes->findBySlug((string) $payload['slug']);
            if ($row !== null) {
                $blockTypes->updateStyle(
                    (string) $row['uuid'],
                    $payload['style_capabilities'] ?? null,
                    $payload['style_targets'] ?? null,
                    $payload['flags'] ?? null,
                    $row['starter_content'] ?? $payload['starter_content'] ?? null,
                );
            }
        }
        $container->get(BlockStyleRegistry::class)->reset();

        $choice = static fn (string $value): array => ['type' => 'choice', 'value' => $value];
        $reset = ['type' => 'reset'];

        // Real logos for the Logos blocks: the listing seed's images, inlined into the pages.
        $disk = (string) config($context, 'thallo.media_disk', 'local');
        foreach (ListingPageSeed::IMAGES as $blob => $file) {
            $db->table('blobs')->insert([
                'uuid' => $blob, 'name' => basename($file), 'mime_type' => 'image/png', 'size' => 1,
                'url' => 'uploads/' . basename($file), 'visibility' => 'public', 'status' => 'active',
                'storage_type' => $disk, 'created_by' => 'user00000001', 'created_at' => '2026-07-01 00:00:00',
            ]);
        }

        // A style class giving casing, spacing and an underline; the Heading wearing it overrides
        // the casing alone.
        $db->table('style_classes')->insert([
            'id' => 'shoutclass01', 'name' => 'Shout', 'name_key' => 'shout', 'version' => 1,
            'style' => json_encode(['typography' => [
                'transform' => $choice('uppercase'),
                'letter_spacing' => $choice('wide'),
                'decoration' => $choice('underline'),
            ]]),
            'created_at' => gmdate('Y-m-d H:i:s'), 'updated_at' => gmdate('Y-m-d H:i:s'),
        ]);
        $container->get(StyleClassProvider::class)->refresh();

        $heading = static fn (string $id, string $text, array $typography = [], array $classes = []): array => [
            'id' => $id, 'type' => 'heading', 'data' => ['text' => $text, 'level' => 'h2'],
            'settings' => array_filter(['style' => array_filter(['typography' => $typography]), 'classes' => $classes]),
        ];
        $links = static fn (string $id, array $link = []): array => [
            'id' => $id, 'type' => 'links', 'data' => ['title' => 'Explore', 'items' => [
                ['label' => 'One', 'url' => '/one'],
                ['label' => 'Two', 'url' => '/two'],
            ]],
            'settings' => $link === [] ? [] : ['parts' => ['link' => ['typography' => $link]]],
        ];
        $button = static fn (string $id, array $typography = []): array => [
            'id' => $id, 'type' => 'button',
            'data' => ['label' => 'Read more', 'url' => '/more', 'variant' => 'link'],
            'settings' => $typography === [] ? [] : ['style' => ['typography' => $typography]],
        ];
        $logos = static fn (string $id, bool $scroll = false, array $style = []): array => [
            'id' => $id, 'type' => 'logos',
            'data' => ['images' => array_keys(ListingPageSeed::IMAGES), 'scroll' => $scroll],
            'settings' => $style === [] ? [] : ['style' => $style],
        ];
        $body = [
            $heading('headplain001', 'Quiet title'),
            $heading('headcase0001', 'Quiet title', ['transform' => $choice('uppercase'), 'letter_spacing' => $choice('wider')]),
            $heading('headnormal01', 'Quiet title', ['letter_spacing' => $choice('normal')]),
            $heading('headreset001', 'Quiet title', ['transform' => $reset, 'letter_spacing' => $reset, 'decoration' => $reset]),
            $heading('headclass001', 'Quiet title', ['transform' => $choice('lowercase')], ['shoutclass01']),
            $links('linkplain001'),
            $links('linkunder001', ['decoration' => $choice('underline')]),
            $links('linknone0001', ['decoration' => $choice('none')]),
            $links('linkreset001', ['decoration' => $reset]),
            $button('btnplain0001'),
            $button('btnunder0001', ['decoration' => $choice('underline')]),
            $button('btnnone00001', ['decoration' => $choice('none')]),
            $button('btnreset0001', ['decoration' => $reset]),
            // A Separator's colour is drawn by its lines, and its label takes Typography.
            ['id' => 'sepplain0001', 'type' => 'separator', 'data' => ['label' => 'Or'], 'settings' => []],
            ['id' => 'sepstyled001', 'type' => 'separator', 'data' => ['label' => 'Or'], 'settings' => ['style' => [
                'colors' => ['border' => ['type' => 'token', 'value' => 'color.accent']],
                'typography' => ['transform' => $choice('uppercase'), 'letter_spacing' => $choice('wider')],
            ]]],
            // Logos: untouched; sized per width with its gaps set; scrolling, sized; and capped.
            $logos('logoplain001'),
            $logos('logosized001', false, [
                'logos' => ['height' => ['base' => $choice('sm'), 'lg' => $choice('xl')]],
                'layout' => ['gap' => [
                    'column' => ['base' => ['type' => 'token', 'value' => 'spacing.xs']],
                    'row' => ['base' => ['type' => 'token', 'value' => 'spacing.none']],
                ]],
            ]),
            $logos('logoscroll01', true, ['logos' => ['height' => ['base' => $choice('lg')]]]),
            // A Narrow cap over Extra large logos: the wide one (4:3) scales down, the square fits.
            $logos('logocapped01', false, ['logos' => [
                'height' => ['base' => $choice('xl')],
                'max_width' => ['base' => $choice('sm')],
            ]]),
        ];

        $type = (string) $container->get(ContentTypeRepository::class)->create([
            'slug' => 'landing', 'name' => 'Landing pages', 'public_delivery' => true, 'schema' => [
                ['name' => 'title', 'type' => 'string', 'required' => true],
                ['name' => 'body', 'type' => 'blocks'],
            ],
        ]);
        $entry = (new ListingPageSeed($container, $context))
            ->publish($type, 'text-style', ['title' => 'Text style', 'body' => $body], '2026-07-01 09:00:00');

        // Published: what a visitor receives.
        $public = $app->handle(Request::create('/landing/text-style', 'GET'));
        if ($public->getStatusCode() !== 200) {
            throw new RuntimeException("/landing/text-style answered {$public->getStatusCode()}");
        }
        file_put_contents($out . '/public.html', $selfContained((string) $public->getContent()));

        // The canvas stage the editor frames, from the same entry.
        $mint = $container->get(PreviewController::class)->mint(
            new MintPreviewData(),
            Request::create('/x', 'POST', [], [], [], ['CONTENT_TYPE' => 'application/json'], '{}'),
            $entry,
            'en',
        );
        $token = (string) (json_decode((string) $mint->getContent(), true)['data']['token'] ?? '');
        if ($token === '') {
            throw new RuntimeException('mint returned no token');
        }
        $stage = $container->get(RenderController::class)->preview(
            Request::create('/_preview/' . $token . '?canvas=1', 'GET'),
            $token,
        );
        if ($stage->getStatusCode() !== 200) {
            throw new RuntimeException("the stage returned {$stage->getStatusCode()}");
        }
        file_put_contents($out . '/stage.html', $selfContained((string) $stage->getContent()));

        throw new TextStyleFixturesWritten();
    });
} catch (TextStyleFixturesWritten) {
    // Written, and rolled back.
} catch (Throwable $e) {
    $detail = $e instanceof \Thallo\Core\Content\Validation\ValidationException ? ' ' . json_encode($e->errors()) : '';
    fwrite(STDERR, 'the text style fixtures failed: ' . $e::class . ': ' . $e->getMessage() . $detail . "\n");
    exit(1);
}

fwrite(STDOUT, "Wrote public.html, stage.html to tools/runtime-browser/fixtures/text-style.\n");
