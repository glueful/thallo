#!/usr/bin/env bash
# Upgrade rehearsal (visual builder spec §7.4/§7.6, plan A4.7): the populated beta.28 fixture
# is upgraded under the cutover contract in four scenarios, each from a fresh restore:
#   1. dry run -> the expected unmappables -> the committed decisions -> live -> stamps and
#      rendering asserted (and a snapshot of the converted state for the next slice);
#   2. interrupted: the live run aborts after its first source, a rerun lands on the identical
#      state and no document is half-converted;
#   3. stale decisions: a document edited after the decisions were recorded makes the live run
#      refuse, naming it;
#   4. backup restore returns the pre-conversion state.
#
# Usage: composer test:upgrade   (never concurrently with the PHP suite: same database)
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
FIXTURE="$ROOT/tests/fixtures/upgrade/beta28.sql"
DECISIONS="$ROOT/tests/fixtures/upgrade/beta28.decisions.json"
SNAPSHOT="$ROOT/tests/fixtures/upgrade/after-group-1.sql"
WORK="$ROOT/storage/rehearsal"
export APP_ENV=testing DB_POOLING_ENABLED=false
DB="${DB_PGSQL_DATABASE:-app_test}"
[[ "$DB" == "app_test" || "$DB" == *_test ]] || { echo "refusing to restore into non-test database '$DB'" >&2; exit 1; }
[[ -f "$FIXTURE" ]] || { echo "fixture missing: $FIXTURE (run scripts/build-upgrade-fixture)" >&2; exit 1; }
mkdir -p "$WORK"

# Postgres client credentials: the environment (CI) or the repo's .env (local).
env_get() { grep -E "^$1=" "$ROOT/.env" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"'; }
export PGHOST="${DB_PGSQL_HOST:-$(env_get DB_PGSQL_HOST)}"
export PGPORT="${DB_PGSQL_PORT:-$(env_get DB_PGSQL_PORT)}"
export PGUSER="${DB_PGSQL_USERNAME:-$(env_get DB_PGSQL_USERNAME)}"
export PGPASSWORD="${DB_PGSQL_PASSWORD:-$(env_get DB_PGSQL_PASSWORD)}"
PSQL=(psql -v ON_ERROR_STOP=1 -q -d "$DB")
run() { (cd "$ROOT" && DB_PGSQL_DATABASE="$DB" "$@"); }
convert() { run php glueful thallo:blocks:convert-settings --no-interaction "$@"; }
checksum() { run php scripts/upgrade-rehearsal-checksum.php; }

restore() {
  echo "== restore beta.28 fixture into $DB and migrate with this checkout =="
  run php scripts/reset-test-db.php >/dev/null
  "${PSQL[@]}" -f "$FIXTURE" >/dev/null
  run php scripts/run-test-migrations.php | grep -E "Applied|Failed|verified"
}

echo "################ scenario 1: dry run, decisions, live"
restore
echo "== doctor =="
run php glueful thallo:doctor --no-interaction | tail -3
PRE="$(checksum)"; echo "pre-conversion state: $PRE"
echo "== dry run =="
convert --dry-run --report="$WORK/dry.jsonl" --decisions=/nonexistent
UNMAPPABLE="$(grep -c '"status":"unmappable"' "$WORK/dry.jsonl" || true)"
echo "unmappable diagnostics: $UNMAPPABLE"
[[ "$UNMAPPABLE" -gt 0 ]] || { echo "the fixture must carry unmappable values" >&2; exit 1; }
if [[ "${REHEARSAL_RECORD_DECISIONS:-0}" == "1" ]]; then
  run php scripts/upgrade-fixture-decide.php "$WORK/dry.jsonl" "$DECISIONS"
fi
[[ -f "$DECISIONS" ]] || { echo "decisions missing: $DECISIONS (REHEARSAL_RECORD_DECISIONS=1 records them)" >&2; exit 1; }
echo "== live refuses without decisions =="
if convert --report="$WORK/refused.jsonl" --decisions=/nonexistent >/dev/null 2>&1; then
  echo "live run must refuse while diagnostics are unresolved" >&2; exit 1
fi
echo "== live with the committed decisions =="
convert --report="$WORK/live.jsonl" --decisions="$DECISIONS"
echo "== every document stamped =="
run php scripts/upgrade-rehearsal-check.php --converted
CONVERTED="$(checksum)"; echo "converted state: $CONVERTED"
[[ "$CONVERTED" != "$PRE" ]] || { echo "conversion changed nothing" >&2; exit 1; }
echo "== idempotent: a rerun finds nothing pending =="
convert --report="$WORK/again.jsonl" --decisions="$DECISIONS" | grep -E "pending: 0"
if [[ "${REHEARSAL_SNAPSHOT:-0}" == "1" ]]; then
  pg_dump --clean --if-exists --no-owner --no-privileges --no-comments "$DB" > "$SNAPSHOT"
  echo "snapshot after group one -> $SNAPSHOT"
fi

echo "################ scenario 2: interrupted, then rerun"
restore
if THALLO_CONVERT_ABORT_AFTER_SOURCE=entry_draft convert --report="$WORK/interrupted.jsonl" --decisions="$DECISIONS" >/dev/null 2>&1; then
  echo "the interrupted run must fail" >&2; exit 1
fi
echo "== no document is half-converted: stamps and trees agree =="
run php scripts/upgrade-rehearsal-check.php --consistent
convert --report="$WORK/resumed.jsonl" --decisions="$DECISIONS" >/dev/null
RESUMED="$(checksum)"; echo "resumed state:   $RESUMED"
[[ "$RESUMED" == "$CONVERTED" ]] || { echo "an interrupted run resumed to a different state" >&2; exit 1; }

echo "################ scenario 3: stale decisions"
restore
run php scripts/upgrade-rehearsal-check.php --touch-one
if convert --report="$WORK/stale.jsonl" --decisions="$DECISIONS" >"$WORK/stale.out" 2>&1; then
  echo "the live run must refuse a stale decision" >&2; exit 1
fi
grep -q "stale" "$WORK/stale.jsonl" || { echo "the report must name the stale decision" >&2; exit 1; }
grep -q "unresolved" "$WORK/stale.out"

echo "################ scenario 4: restore from backup"
restore
pg_dump --clean --if-exists --no-owner --no-privileges --no-comments "$DB" > "$WORK/backup.sql"
BEFORE="$(checksum)"
convert --report="$WORK/live2.jsonl" --decisions="$DECISIONS" >/dev/null
run php scripts/reset-test-db.php >/dev/null
"${PSQL[@]}" -f "$WORK/backup.sql" >/dev/null
AFTER="$(checksum)"
[[ "$AFTER" == "$BEFORE" ]] || { echo "restoring the backup did not return the pre-state" >&2; exit 1; }
echo "restored state matches the backup: $AFTER"
echo "== upgrade rehearsal: OK =="
