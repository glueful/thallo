#!/usr/bin/env bash
# Build the populated beta.28 upgrade fixture (visual builder plan A1.6).
#
# Installs glueful/thallo 1.0.0-beta.28 from Packagist into a scratch directory against a
# dedicated database, provisions it, seeds it with scripts/upgrade-fixture-seed.php (every
# legacy presentation value the conversion must handle, drafts, two retained versions per
# published entry, both regions), and dumps schema + data to tests/fixtures/upgrade/beta28.sql.
#
# Usage: scripts/build-upgrade-fixture            # needs network, composer, pg_dump, createdb
# Env:   FIXTURE_DB (default thallo_beta28_fixture), FIXTURE_VERSION (default 1.0.0-beta.28)
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT="$ROOT/tests/fixtures/upgrade/beta28.sql"
VERSION="${FIXTURE_VERSION:-1.0.0-beta.28}"
DB="${FIXTURE_DB:-thallo_beta28_fixture}"
SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/thallo-fixture-XXXXXX")"
# The app role usually cannot create databases; an admin role does that (postgres locally and
# in CI), handing ownership to the app role.
ADMIN="${FIXTURE_ADMIN_USER:-postgres}"
cleanup() {
  [[ "${KEEP_SCRATCH:-0}" == "1" ]] && { echo "scratch kept at $SCRATCH (database $DB kept)"; return; }
  rm -rf "$SCRATCH"; dropdb -U "$ADMIN" --if-exists "$DB" >/dev/null 2>&1 || true
}
trap cleanup EXIT

# Postgres client tools take the repo's credentials (the same ones the install will use).
env_get() { grep -E "^$1=" "$ROOT/.env" | head -1 | cut -d= -f2- | tr -d '"'; }
export PGHOST="${DB_PGSQL_HOST:-$(env_get DB_PGSQL_HOST)}"
export PGPORT="${DB_PGSQL_PORT:-$(env_get DB_PGSQL_PORT)}"
export PGUSER="${DB_PGSQL_USERNAME:-$(env_get DB_PGSQL_USERNAME)}"
export PGPASSWORD="${DB_PGSQL_PASSWORD:-$(env_get DB_PGSQL_PASSWORD)}"

echo "+ composer create-project glueful/thallo $VERSION -> $SCRATCH"
composer create-project --stability=beta --no-interaction --no-progress --prefer-dist \
  glueful/thallo "$SCRATCH" "$VERSION" >/dev/null

echo "+ database $DB"
dropdb -U "$ADMIN" --if-exists "$DB" >/dev/null 2>&1 || true
createdb -U "$ADMIN" -O "$PGUSER" "$DB"

# Environment: the repo's DB credentials, the fixture database, no pooling.
cp "$ROOT/.env" "$SCRATCH/.env.repo"
{
  grep -E '^(DB_DRIVER|DB_PGSQL_HOST|DB_PGSQL_PORT|DB_PGSQL_USERNAME|DB_PGSQL_PASSWORD|DB_PGSQL_SCHEMA)=' "$SCRATCH/.env.repo" || true
  echo "DB_PGSQL_DATABASE=$DB"
  echo "APP_ENV=production"
  # Debug on while seeding: a seed failure must print its exception, not a bare 500 envelope.
  echo "APP_DEBUG=true"
  echo "DB_POOLING_ENABLED=false"
  echo "CACHE_DRIVER=array"
  echo "APP_KEY=$(php -r 'echo bin2hex(random_bytes(16));')"
  echo "JWT_KEY=$(php -r 'echo bin2hex(random_bytes(32));')"
  echo "TOKEN_SALT=$(php -r 'echo bin2hex(random_bytes(16));')"
} > "$SCRATCH/.env.fixture"
grep -vE '^(DB_PGSQL_DATABASE|APP_ENV|APP_DEBUG|DB_POOLING_ENABLED|CACHE_DRIVER|APP_KEY|JWT_KEY|TOKEN_SALT|DB_DRIVER|DB_PGSQL_HOST|DB_PGSQL_PORT|DB_PGSQL_USERNAME|DB_PGSQL_PASSWORD|DB_PGSQL_SCHEMA)=' "$SCRATCH/.env" > "$SCRATCH/.env.rest" || true
cat "$SCRATCH/.env.fixture" "$SCRATCH/.env.rest" > "$SCRATCH/.env"
rm -f "$SCRATCH/.env.repo" "$SCRATCH/.env.fixture" "$SCRATCH/.env.rest"

echo "+ provision + starter block types"
(cd "$SCRATCH" && php glueful thallo:provision --no-interaction >/dev/null)
# A fresh install seeds its starter block types during setup, which this build skips;
# provision seeds them only once an instance is installed. Seed explicitly.
(cd "$SCRATCH" && php glueful thallo:blocks:seed --no-interaction | tail -1)

echo "+ seed"
cp "$ROOT/scripts/upgrade-fixture-seed.php" "$SCRATCH/upgrade-fixture-seed.php"
(cd "$SCRATCH" && php upgrade-fixture-seed.php)
cp "$SCRATCH/fixture-manifest.json" "$ROOT/tests/fixtures/upgrade/beta28.manifest.json"

echo "+ dump -> $OUT"
pg_dump --clean --if-exists --no-owner --no-privileges --no-comments "$DB" > "$OUT"
# Ownership-neutral: the rehearsal restores as whichever role runs it.
echo "fixture: $(wc -c < "$OUT") bytes, version $VERSION"
