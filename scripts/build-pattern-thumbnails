#!/usr/bin/env php
<?php
/**
 * Build the thumbnails of the section and page library (admin/public/pattern-thumbs/<slug>.jpg):
 * every pattern rendered through the DEFAULT theme's own templates and stylesheets and captured
 * in Chromium by tools/style-proofs — so a thumbnail is the section, not a drawing of it. A
 * section is captured whole at half scale (600px wide); a page is its first screens.
 *
 * A layout's sections and templates are pictured as the layout stage shows them (sections and
 * templates design §6): opened in a real layout session on fixture content of their own — a post type
 * with written, illustrated posts, and the fixture shop — whatever else the database holds, and
 * cropped to the surface's frame (a template) or to the section's own blocks.
 *
 * Run it again when a pattern or the default theme's look changes; PatternThumbnailsTest fails
 * while a pattern has no thumbnail, or a thumbnail no pattern.
 *
 *   CACHE_DRIVER=array DB_PGSQL_DATABASE=app_test APP_ENV=testing php scripts/build-pattern-thumbnails
 */

declare(strict_types=1);

use Glueful\Bootstrap\ApplicationContext;
use Thallo\Core\Content\Patterns\PatternLibrary;
use Thallo\Core\Tests\Support\ShopPageSeed;

require __DIR__ . '/../vendor/autoload.php';
require __DIR__ . '/lib/showcase.php';
require __DIR__ . '/lib/shop-thumbnails.php';
require __DIR__ . '/lib/layout-thumbnails.php';

$root = dirname(__DIR__);
$container = showcase_boot($root);
$render = showcase_renderer($container, $root, 'default');
// Pictures of the shop's blocks: the shop's own stylesheet arrives with the packs' contributions.
$renderShop = showcase_renderer($container, $root, 'default', true);

$work = $root . '/tools/style-proofs/fixtures/patterns';
$out = $root . '/admin/public/pattern-thumbs';
foreach ([$work, $out] as $dir) {
    if (!is_dir($dir) && !mkdir($dir, 0755, true)) {
        fwrite(STDERR, "cannot create {$dir}\n");
        exit(1);
    }
}
// A thumbnail no pattern owns is a stale file: start clean.
foreach (glob($out . '/*.jpg') ?: [] as $stale) {
    unlink($stale);
}

/**
 * A form ships with no recipient — the author has to say where messages go, and until then the
 * block says so in place of its fields. The PICTURE shows the form as it will look once set up.
 */
$fixtureProduct = '';
$configured = static function (array $blocks) use (&$configured, &$fixtureProduct): array {
    return array_map(static function (array $block) use (&$configured, &$fixtureProduct): array {
        if ($block['type'] === 'form' && ($block['data']['recipient'] ?? '') === '') {
            $block['data']['recipient'] = 'hello@example.com';
        }
        // A shop pattern ships no product (sections and templates design §6); its PICTURE shows one
        // of the fixture shop's, seeded below and rolled back.
        if (
            in_array($block['type'], ['featured-product', 'add-to-cart'], true)
            && ($block['data']['product_slug'] ?? '') === ''
        ) {
            $block['data']['product_slug'] = $fixtureProduct;
        }
        foreach ($block['data'] as $key => $value) {
            if (is_array($value) && $value !== [] && is_array($value[0] ?? null) && isset($value[0]['type'])) {
                $block['data'][$key] = $configured($value);
            }
        }
        return $block;
    }, $blocks);
};

/**
 * A header's pictures show a site as it will look: a name for the logo to fall back to, and a
 * main menu with a few pages in it. The menu lives only while the pages render — rolled back
 * before anything is captured, so the test database keeps what it had.
 */
$site = ['name' => 'Acme'];
$db = $container->get(Glueful\Database\Connection::class);
$db->getTransactionManager()->begin();
if ($db->table('navigation_menus')->where('slug', '=', 'main')->first() === null) {
    $now = gmdate('Y-m-d H:i:s');
    $db->table('navigation_menus')->insert([
        'uuid' => 'showcasemenu', 'slug' => 'main', 'name' => 'Main', 'lock_version' => 0,
        'position' => 0, 'created_at' => $now, 'updated_at' => $now,
    ]);
    foreach (['Home', 'About', 'Blog', 'Contact'] as $i => $label) {
        $db->table('navigation_items')->insert([
            'uuid' => 'showcaseitm' . $i, 'menu_uuid' => 'showcasemenu', 'parent_uuid' => null,
            'position' => $i, 'kind' => 'url', 'entry_uuid' => null, 'url' => '#', 'icon' => null,
            'labels' => json_encode(['en' => $label]), 'descriptions' => null,
            'created_at' => $now, 'updated_at' => $now,
        ]);
    }
}

/**
 * The shop the shop patterns' pictures show: ShopPageSeed's products — active variants, committed
 * cover images — seeded in the same rolled-back transaction, under the widened-schema flags the
 * seed works in (rolled back with everything else).
 */
$shopSeed = new ShopPageSeed($container, $container->get(ApplicationContext::class));
$outsideShop = $shopSeed->useTenant();
$shopSeed->clear();
$fixtureProduct = (string) $db->table('commerce_products')
    ->where('uuid', '=', $shopSeed->seed()['products'][0])->first()['slug'];
// Every product named and pictured, as the layout pictures' shop is (scripts/lib/layout-thumbnails.php).
layout_thumbnail_shop_pictures($container, $container->get(ApplicationContext::class), $db);
$shopImages = ShopPageSeed::IMAGES + LAYOUT_THUMBNAIL_SHOP_IMAGES;
// Only the shop pictures render in the seed's workspace: every other picture keeps the single site
// (a header's menu, seeded above, belongs to no workspace).
$shopSeed->restoreTenant($outsideShop);
/** How many of the shop's script-painted blocks a pattern holds: its picture waits for all of them. */
$shopBlocks = static fn (array $pattern): int => (int) preg_match_all(
    '~"type":"(product-grid|featured-product|add-to-cart)"~',
    (string) json_encode($pattern['blocks']),
);

$jobs = [];
foreach ($container->get(PatternLibrary::class)->all() as $pattern) {
    $page = $work . '/' . $pattern['slug'] . '.html';
    $shop = $shopBlocks($pattern) > 0;
    $outside = $shop ? $shopSeed->useTenant() : [];
    $html = ($shop ? $renderShop : $render)(
        showcase_with_ids($configured($pattern['blocks'])),
        $pattern['slug'],
        $pattern['region'] ?? null,
        $site,
    );
    if ($shop) {
        // The shop's blocks paint with script: each answered with the controller's own response to
        // its exact request, and the picture taken only once every one of them has painted.
        $html = shop_inject($html, shop_block_responses($html, $container, $shopImages, $root), $root);
        $shopSeed->restoreTenant($outside);
    }
    file_put_contents($page, $html);
    $jobs[] = ($shop ? ['ready' => 'shop', 'shopBlocks' => $shopBlocks($pattern)] : []) + [
        'page' => $page,
        'out' => $out . '/' . $pattern['slug'] . '.jpg',
        // A header or footer is short and wide: drawn narrower (still wide enough for the desktop
        // menu and the footer's four columns), so the same 600px picture shows it larger.
        'width' => ($pattern['region'] ?? null) === null ? 1200 : 1040,
        'scale' => ($pattern['region'] ?? null) === null ? 0.5 : 600 / 1040,
        'quality' => 80,
        // The blocks themselves: the margins a theme puts around a band are the page's, not its.
        'trim' => true,
        // A page's thumbnail is its first screens; a section is shown whole.
        'maxHeight' => $pattern['kind'] === 'page' ? 2400 : 1600,
    ];
}
$db->getTransactionManager()->rollback();

// The layouts' patterns, in a transaction of their own: isolated targets with no sample to pick.
$frames = [
    'entry' => '.thallo-layout--entry',
    'listing' => '.thallo-layout--listing',
    'archive' => '.thallo-layout--archive',
    'product' => '.shop-product--layout',
    'shop_index' => '.shop-index--layout',
    'shop_category' => '.shop-category--layout',
];
$handle = static fn (Symfony\Component\HttpFoundation\Request $request): Symfony\Component\HttpFoundation\Response
    => Thallo\Core\Tests\Support\TestApplication::instance()->handle($request);
$surfaces = $container->get(Thallo\Contracts\Layouts\LayoutSurfaceRegistry::class);
$library = $container->get(PatternLibrary::class);
$pictured = [];
$db->getTransactionManager()->begin();
try {
    $fixtures = layout_thumbnail_fixtures($container);
    foreach ($fixtures['targets'] as $surface => $target) {
        foreach ($library->forLayout($surface, $target) as $pattern) {
            if ($pattern['saved']) {
                continue;
            }
            if ($pattern['kind'] === 'page') {
                $blocks = PatternLibrary::withIds($pattern['blocks']);
                $settings = (array) $pattern['settings'];
                $selector = $frames[$surface];
            } else {
                // A section on the surface's starter, which holds the required block no section does.
                $section = $pattern['blocks'][0];
                $blocks = [...PatternLibrary::withIds($surfaces->get($surface)->starter($target)), ['id' => 'thumbsection1'] + $section];
                $settings = [];
                $selector = '[data-thallo-block="thumbsection1"]';
            }
            $page = $work . '/' . $pattern['slug'] . '.html';
            file_put_contents($page, layout_thumbnail_in_place($fixtures, $surface, static fn (): string => layout_stage_html(
                $container,
                $handle,
                $surface,
                $target,
                $blocks,
                $settings,
                $fixtures['samples'][$surface],
                $fixtures['images'],
            )));
            $pictured[] = $pattern['slug'];
            $jobs[] = [
                'page' => $page,
                'out' => $out . '/' . $pattern['slug'] . '.jpg',
                'width' => 1200,
                'scale' => 0.5,
                'quality' => 80,
                'selector' => $selector,
                'maxHeight' => $pattern['kind'] === 'page' ? 2400 : 1600,
            ];
        }
    }
} finally {
    $db->getTransactionManager()->rollback();
}
$missing = array_diff($library->layoutSlugs(), $pictured);
if ($missing !== []) {
    fwrite(STDERR, 'No picture for the layout patterns: ' . implode(', ', $missing) . "\n");
    exit(1);
}

$jobsFile = $work . '/jobs.json';
file_put_contents($jobsFile, json_encode($jobs));
passthru('node ' . escapeshellarg($root . '/tools/style-proofs/capture-page.js') . ' ' . escapeshellarg($jobsFile), $status);
if ($status !== 0) {
    fwrite(STDERR, "The capture failed (run `npm install` in tools/style-proofs).\n");
    exit(1);
}
// Each picture's size, for the admin to reserve its place before it loads: a card that grows
// when its image arrives moves every card below it, under the author's pointer.
$sizes = [];
foreach (glob($out . '/*.jpg') ?: [] as $file) {
    [$width, $height] = (array) getimagesize($file);
    $sizes[basename($file, '.jpg')] = [(int) $width, (int) $height];
}
ksort($sizes);
// Laid out as the admin's formatter lays JSON out, so a rebuild never fails its format check.
$rows = [];
foreach ($sizes as $slug => [$width, $height]) {
    $rows[] = '  ' . json_encode($slug, JSON_THROW_ON_ERROR) . ": [{$width}, {$height}]";
}
file_put_contents(
    $root . '/admin/src/editor/palette/patternThumbSizes.json',
    "{\n" . implode(",\n", $rows) . "\n}\n",
);
$bytes = array_sum(array_map('filesize', glob($out . '/*.jpg') ?: []));
fwrite(STDOUT, 'Wrote ' . count($jobs) . ' thumbnails to admin/public/pattern-thumbs (' . number_format($bytes) . " bytes).\n");
