#!/usr/bin/env bash
#
# Dist-archive verification (DISTRIBUTION.md release-bake HARD GATE).
#
# Asserts the tree a tag would ship — `git archive` honors .gitattributes export-ignore, and
# Packagist dists are exactly this archive. Run against the release commit BEFORE tagging.
#
# Usage: scripts/verify-dist-archive [<ref>]   (default: HEAD)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

REF="${1:-HEAD}"
LISTING="$(git archive "$REF" | tar -t)"

fail=0

must_contain() {
  if ! grep -qx "$1" <<< "$LISTING"; then
    echo "FAIL: dist archive of $REF is missing: $1" >&2
    fail=1
  else
    echo "ok: contains $1"
  fi
}

must_not_contain_prefix() {
  if grep -q "^$1" <<< "$LISTING"; then
    echo "FAIL: dist archive of $REF must not contain: $1*" >&2
    grep "^$1" <<< "$LISTING" | head -3 >&2
    fail=1
  else
    echo "ok: excludes $1*"
  fi
}

# The baked admin bundle IS the shipped admin (decision 9).
must_contain "public/admin/index.html"
# The SPA source toolchain never ships.
must_not_contain_prefix "admin/"
# Internal engineering record never ships.
must_not_contain_prefix "docs/internal/"
# The dogfood dev overlay never ships — fresh installs get the trimmed base posture.
must_not_contain_prefix "config/development/"

# The baked bundle must EMBED the whole lucide set. The admin's document CSP is connect-src
# 'self', so an icon the build did not embed is fetched from api.iconify.design at runtime and
# blocked — a blank icon in production. A source scan can never be complete: block/content
# types carry icon names chosen in the admin's icon picker or seeded from PHP, reaching the
# SPA as API data (beta.13 shipped 28 blank icons from unscanned .ts; beta.17 shipped 20 from
# seeded block types). The embedded collection serialises each icon as "<name>":{"width"…/
# "body"…: first a floor on the count (lucide has ~1.9k icons; a scanned subset is a few
# hundred), then every name the sources reference, as a second, specific check.
LUCIDE_FLOOR=1800
BUNDLE_JS="$(git archive "$REF" public/admin/assets 2>/dev/null | tar -xO 2>/dev/null || true)"
EMBEDDED_COUNT="$(grep -oE '"[a-z0-9-]+":\{"(width|height|body|left|top)' <<< "$BUNDLE_JS" | sort -u | wc -l | tr -d ' ')"
if [[ "$EMBEDDED_COUNT" -lt "$LUCIDE_FLOOR" ]]; then
  echo "FAIL: the baked bundle embeds $EMBEDDED_COUNT icons; the whole lucide set (>= $LUCIDE_FLOOR) must be embedded (admin/vite.config.ts icon.clientBundle)" >&2
  fail=1
else
  echo "ok: the baked bundle embeds the lucide set ($EMBEDDED_COUNT icons)"
fi
ICON_NAMES="$(git grep -hoE 'i-lucide-[a-z0-9-]+' "$REF" -- \
    'admin/src/*.ts' 'admin/src/*.vue' 'core/src/*.php' 'packages/*.php' ':(exclude)*/tests/*' \
  | sed 's/^i-lucide-//' | sort -u || true)"
if [[ -z "$ICON_NAMES" ]]; then
  echo "FAIL: could not collect icon names from admin/src at $REF" >&2
  fail=1
else
  missing=()
  while IFS= read -r name; do
    if ! grep -q "\"$name\":{\"" <<< "$BUNDLE_JS"; then
      missing+=("$name")
    fi
  done <<< "$ICON_NAMES"
  if [[ "${#missing[@]}" -ne 0 ]]; then
    echo "FAIL: ${#missing[@]} referenced icon(s) are not embedded in the baked bundle (would be fetched remotely and blocked by CSP):" >&2
    printf '  i-lucide-%s\n' "${missing[@]}" | head -30 >&2
    fail=1
  else
    echo "ok: every referenced lucide icon is embedded ($(wc -l <<< "$ICON_NAMES" | tr -d ' ') icons)"
  fi
fi

if [[ "$fail" -ne 0 ]]; then
  echo "verify-dist-archive: FAILED for $REF" >&2
  exit 1
fi
echo "verify-dist-archive: OK for $REF"
