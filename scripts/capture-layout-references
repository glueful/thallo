#!/usr/bin/env php
<?php
/**
 * Freeze the OLD layout appearance (container-layout plan, Task 0.1) before any shared CSS
 * changes. For every case definition in `tests/fixtures/layout/references/*.json` this renders the
 * case's `old` block tree with the CURRENT templates and theme, twice — once public, once with
 * block annotations on (the canvas rendering) — into self-contained pages under the gitignored
 * `tools/runtime-browser/fixtures/references/`, then measures each page in Chromium
 * (`tools/runtime-browser/scripts/measure.js`) and writes the committed measurements to
 * `tools/runtime-browser/references/<case>.json` and `<case>.canvas.json`.
 *
 * The pages inline the layer order, the theme artifact and the compiled settings artifact, so a
 * reference keeps its original CSS even after the theme changes. Nothing here survives the
 * retirement: this script is deleted in Task 4.2, and only the measurements remain.
 *
 *   DB_PGSQL_DATABASE=app_test APP_ENV=testing php scripts/capture-layout-references [case…]
 */

declare(strict_types=1);

use Thallo\Contracts\Style\BlockStyleRegistry;
use Thallo\Core\Content\Blocks\BlockTypeRepository;
use Thallo\Core\Content\Blocks\StarterBlockTypeSeeder;
use Thallo\Core\Content\Starter\Kinds\BlockTypeKind;
use Thallo\Core\Tests\Support\TestApplication;
use Thallo\Render\RenderContextExtension;
use Thallo\Render\Style\StyleCompiler;
use Thallo\Render\Style\ThemeStylesheetArtifact;
use Thallo\Render\ThemeLocator;
use Thallo\Render\TwigFactory;

require __DIR__ . '/../vendor/autoload.php';

foreach (getenv() as $key => $value) {
    $_ENV[$key] ??= $value;
}
$_ENV['DB_POOLING_ENABLED'] = 'false';
$root = dirname(__DIR__);
if (is_file($root . '/.env')) {
    Dotenv\Dotenv::createImmutable($root)->safeLoad();
}
$env = static fn (string $key, ?string $default = null): ?string => $_ENV[$key] ?? (getenv($key) === false ? $default : getenv($key));
if ($env('APP_ENV', 'development') !== 'testing') {
    fwrite(STDERR, "Refusing to capture outside APP_ENV=testing (it seeds the test database).\n");
    exit(1);
}
$database = (string) $env('DB_PGSQL_DATABASE', '');
if ($database !== 'app_test' && !str_ends_with($database, '_test')) {
    fwrite(STDERR, "Refusing to seed non-test database '{$database}'.\n");
    exit(1);
}

$only = array_slice($argv, 1);
$definitions = glob($root . '/tests/fixtures/layout/references/*.json') ?: [];
if ($definitions === []) {
    fwrite(STDERR, "No case definitions; run scripts/build-layout-reference-cases first.\n");
    exit(1);
}

$pages = $root . '/tools/runtime-browser/fixtures/references';
$measurements = $root . '/tools/runtime-browser/references';
foreach ([$pages, $measurements] as $dir) {
    if (!is_dir($dir) && !mkdir($dir, 0755, true)) {
        fwrite(STDERR, "cannot create {$dir}\n");
        exit(1);
    }
}

$container = TestApplication::instance()->getContainer();
$container->get(StarterBlockTypeSeeder::class)->seedMissing();
$blockTypes = $container->get(BlockTypeRepository::class);
foreach ($container->get(BlockTypeKind::class)->definitions() as $definition) {
    $payload = $definition->payload;
    $row = $blockTypes->findBySlug((string) $payload['slug']);
    if ($row !== null) {
        $blockTypes->updateStyle(
            (string) $row['uuid'],
            $payload['style_capabilities'] ?? null,
            $payload['style_targets'] ?? null,
            $payload['flags'] ?? null,
            $row['starter_content'] ?? $payload['starter_content'] ?? null,
        );
    }
}
$container->get(BlockStyleRegistry::class)->reset();

$theme = new ThemeLocator('default', $root . '/themes');
$vocabulary = $theme->vocabulary();
$themeDir = $theme->themeDir();
$sheets = array_map(static fn (string $rel): string => $themeDir . '/' . $rel, $vocabulary->stylesheets());
$css = implode("\n", [
    (string) file_get_contents($root . '/packages/thallo-render/assets/style/layers.css'),
    ThemeStylesheetArtifact::build($sheets)->css,
    StyleCompiler::compile($vocabulary),
]);

// The stage's own stylesheet: the annotation wrapper is display:contents there, so a canvas
// reference measured without it would freeze geometry the stage never shows.
$previewCss = (string) file_get_contents($root . '/packages/thallo-render/assets/preview/preview.css');

$extension = $container->get(RenderContextExtension::class);
$twig = (new TwigFactory($theme, $extension, $root . '/storage/cache/twig'))->environment();

/** The page a reference is measured in: the case root, the rendering, and the frozen CSS. */
$page = static function (string $case, string $body, string $css): string {
    return <<<HTML
<!doctype html>
<meta charset="utf-8">
<title>{$case}</title>
<style>
/* Frozen with the reference: the theme and settings artifacts as they were at capture. */
{$css}
body { margin: 0; }
[data-case-root] { width: 100%; }
</style>
<div data-case-root>{$body}</div>
HTML;
};

$node = static function (array $command) use ($root): int {
    $descriptors = [0 => STDIN, 1 => STDOUT, 2 => STDERR];
    $process = proc_open($command, $descriptors, $pipes, $root . '/tools/runtime-browser');
    return is_resource($process) ? proc_close($process) : 1;
};

$captured = 0;
foreach ($definitions as $file) {
    $case = (array) json_decode((string) file_get_contents($file), true, 512, JSON_THROW_ON_ERROR);
    $name = (string) ($case['case'] ?? basename($file, '.json'));
    if ($only !== [] && !in_array($name, $only, true)) {
        continue;
    }
    foreach (['public' => false, 'canvas' => true] as $mode => $annotations) {
        $extension->resetPerRenderState();
        $extension->setBlockAnnotations($annotations);
        $body = $twig->createTemplate('{{ blocks(l) }}')->render(['l' => [$case['old']]]);
        $extension->setBlockAnnotations(false);
        $suffix = $mode === 'public' ? '' : '.canvas';
        $pageFile = $pages . '/' . $name . $suffix . '.html';
        file_put_contents(
            $pageFile,
            $page($name . ' (' . $mode . ')', $body, $annotations ? $css . "\n" . $previewCss : $css),
        );
        $status = $node([
            'node',
            'scripts/measure.js',
            '/tools/runtime-browser/fixtures/references/' . $name . $suffix . '.html',
            $name . $suffix,
            $file,
            $measurements . '/' . $name . $suffix . '.json',
        ]);
        if ($status !== 0) {
            fwrite(STDERR, "measuring {$name} ({$mode}) failed\n");
            exit(1);
        }
        $captured++;
    }
}

fwrite(STDOUT, "Captured {$captured} reference measurements into tools/runtime-browser/references.\n");
