#!/usr/bin/env php
<?php
/**
 * Build the fixtures for admin/e2e (visual builder spec §5.6): the five-deep composition entry
 * rendered in canvas mode by the real render pack, and the admin API responses the Design page
 * needs — content types, block types, the draft, the style schema, the style classes, the
 * capabilities, the runtime config and the preview mint — each captured from the real
 * controller so the proofs drive the page against the shapes the server actually sends.
 *
 * Boots the shared test application against the test database (the same boot the integration
 * suite uses), so run it as the test scripts do:
 *
 *   DB_PGSQL_DATABASE=app_test APP_ENV=testing php scripts/build-builder-proof-fixtures
 *
 * Writes admin/e2e/fixtures/canvas.html, admin/e2e/fixtures/api/*.json and, for the regions stage and
 * the layout stage, admin/e2e/fixtures/regions/ and admin/e2e/fixtures/layouts/ (gitignored).
 */

declare(strict_types=1);

use Thallo\Contracts\Style\BlockStyleRegistry;
use Thallo\Core\Http\Controllers\CapabilityAdminController;
use Thallo\Core\Content\Blocks\BlockTypeRepository;
use Thallo\Core\Content\Blocks\StarterBlockTypeSeeder;
use Thallo\Core\Content\Http\Controllers\BlockTypeController;
use Thallo\Core\Content\Http\Controllers\ContentTypeController;
use Thallo\Core\Content\Http\Controllers\EntryController;
use Thallo\Core\Content\Http\Controllers\PreviewController;
use Thallo\Core\Content\Http\Controllers\StyleClassController;
use Thallo\Core\Content\Http\DTOs\MintPreviewData;
use Thallo\Core\Content\Repositories\ContentTypeRepository;
use Thallo\Core\Content\Repositories\EntryRepository;
use Thallo\Core\Content\Starter\Kinds\BlockTypeKind;
use Thallo\Core\Tests\Support\TestApplication;
use Thallo\Render\Http\Controllers\RenderController;
use Thallo\Render\Style\StyleCompiler;
use Thallo\Render\Style\ThemeStylesheetArtifact;
use Thallo\Render\ThemeLocator;
use Thallo\Render\Http\Controllers\StyleSchemaController;
use Symfony\Component\HttpFoundation\Request;

require __DIR__ . '/../vendor/autoload.php';

foreach (getenv() as $key => $value) {
    $_ENV[$key] ??= $value;
}
$_ENV['DB_POOLING_ENABLED'] = 'false';
$root = dirname(__DIR__);
if (is_file($root . '/.env')) {
    Dotenv\Dotenv::createImmutable($root)->safeLoad();
}
$env = static fn (string $key, ?string $default = null): ?string => $_ENV[$key] ?? (getenv($key) === false ? $default : getenv($key));
if ($env('APP_ENV', 'development') !== 'testing') {
    fwrite(STDERR, "Refusing to build the fixtures outside APP_ENV=testing (they seed the test database).\n");
    exit(1);
}
$database = (string) $env('DB_PGSQL_DATABASE', '');
if ($database !== 'app_test' && !str_ends_with($database, '_test')) {
    fwrite(STDERR, "Refusing to seed non-test database '{$database}'.\n");
    exit(1);
}

$out = $root . '/admin/e2e/fixtures';
if (!is_dir($out . '/api') && !mkdir($out . '/api', 0755, true)) {
    fwrite(STDERR, "cannot create {$out}/api\n");
    exit(1);
}

// The fixtures are an ordinary site with Search on (the Search block in the header palette, its
// scope picker — search-block.spec.ts): the boot reads a testing override, with any stored Search
// switch cleared so the override decides. Both are put back when the build ends, however it ends.
$searchOverrideFile = $root . '/config/testing/thallo.php';
$searchPreviousOverride = is_file($searchOverrideFile) ? (string) file_get_contents($searchOverrideFile) : null;
$searchOverride = $searchPreviousOverride !== null ? (array) (require $searchOverrideFile) : [];
$searchOverride['capabilities'] = ['thallo.search' => true] + (array) ($searchOverride['capabilities'] ?? []);
file_put_contents($searchOverrideFile, "<?php\nreturn " . var_export($searchOverride, true) . ";\n");
$searchFlagsPdo = new PDO(
    sprintf('pgsql:host=%s;port=%s;dbname=%s', $env('DB_PGSQL_HOST', '127.0.0.1'), $env('DB_PGSQL_PORT', '5432'), $database),
    (string) $env('DB_PGSQL_USERNAME', ''),
    (string) $env('DB_PGSQL_PASSWORD', ''),
);
$searchCleared = $searchFlagsPdo->prepare("DELETE FROM thallo_system_flags WHERE key = 'capability.thallo.search.enabled' RETURNING value");
$searchCleared->execute();
$storedSearch = $searchCleared->fetchColumn();
\Thallo\Core\Tests\Support\CapabilityBaseline::advanceVersion($searchFlagsPdo);
register_shutdown_function(static function () use (
    $searchOverrideFile,
    $searchPreviousOverride,
    $searchFlagsPdo,
    $storedSearch,
): void {
    if ($searchPreviousOverride !== null) {
        file_put_contents($searchOverrideFile, $searchPreviousOverride);
    } else {
        @unlink($searchOverrideFile);
    }
    if (is_string($storedSearch)) {
        $searchFlagsPdo->prepare("INSERT INTO thallo_system_flags (key, value) VALUES ('capability.thallo.search.enabled', ?)
            ON CONFLICT (key) DO NOTHING")->execute([$storedSearch]);
    }
    \Thallo\Core\Tests\Support\CapabilityBaseline::advanceVersion($searchFlagsPdo);
});

$container = TestApplication::instance()->getContainer();

// Block types: the shipped starters with their style declarations, as the test suite syncs them.
$container->get(StarterBlockTypeSeeder::class)->seedMissing();
$blockTypes = $container->get(BlockTypeRepository::class);
foreach ($container->get(BlockTypeKind::class)->definitions() as $definition) {
    $payload = $definition->payload;
    $row = $blockTypes->findBySlug((string) $payload['slug']);
    if ($row !== null) {
        $blockTypes->updateStyle(
            (string) $row['uuid'],
            $payload['style_capabilities'] ?? null,
            $payload['style_targets'] ?? null,
            $payload['flags'] ?? null,
            $row['starter_content'] ?? $payload['starter_content'] ?? null,
        );
    }
}
$container->get(BlockStyleRegistry::class)->reset();

// The page content type and the five-deep composition entry.
$contentTypes = $container->get(ContentTypeRepository::class);
$page = $contentTypes->findBySlug('page');
$pageUuid = $page !== null ? (string) $page['uuid'] : $contentTypes->create([
    'slug' => 'page', 'name' => 'Page', 'schema' => [
        ['name' => 'title', 'type' => 'string'],
        ['name' => 'body', 'type' => 'blocks'],
    ],
]);
$page = $contentTypes->findByUuid($pageUuid);
$fixture = json_decode((string) file_get_contents($root . '/tests/fixtures/composition/five-deep.json'), true, 512, JSON_THROW_ON_ERROR);
$entries = $container->get(EntryRepository::class);
$entryUuid = $entries->createEntry($pageUuid, 'en', (int) $page['schema_version'], null);
$draft = $entries->findDraft($entryUuid, 'en');
$entries->saveDraft(
    $entryUuid,
    'en',
    // The composition plus two root-level siblings: the sibling proofs (§5.6) move them as a group.
    // The grid container is the Layout tab's subject (container-layout spec §5): three children in
    // three tracks, so a mode switch to flex is visible as a change of geometry, not only of class.
    ['title' => 'Five deep', 'body' => [
        ...$fixture['body'],
        ['id' => 'head0000000a', 'type' => 'heading', 'data' => ['text' => 'Sibling A'], 'settings' => []],
        ['id' => 'head0000000b', 'type' => 'heading', 'data' => ['text' => 'Sibling B'], 'settings' => []],
        ['id' => 'grid00000001', 'type' => 'container', 'data' => ['element' => 'div', 'content' => [
            ['id' => 'gridhead0001', 'type' => 'heading', 'data' => ['text' => 'One'], 'settings' => []],
            ['id' => 'gridhead0002', 'type' => 'heading', 'data' => ['text' => 'Two'], 'settings' => []],
            // This one enters: the stage holds it still and visible, and the Style tab's Play
            // replays it (motion-play.spec.ts).
            ['id' => 'gridhead0003', 'type' => 'heading', 'data' => ['text' => 'Three'], 'settings' => [
                'style' => ['motion' => [
                    'entrance' => ['type' => 'choice', 'value' => 'fade-up'],
                    'duration' => ['type' => 'choice', 'value' => 'slow'],
                ]],
            ]],
        ]], 'settings' => ['style' => ['layout' => [
            'display' => ['base' => ['type' => 'choice', 'value' => 'grid']],
            'columns' => ['base' => ['type' => 'choice', 'value' => '3']],
            'content_width' => ['base' => ['type' => 'token', 'value' => 'width.container']],
        ]]]],
        // A slot that admits one block type: the refusal proof (§5.6) needs a drop the
        // allow-list rejects, and a container's `content` admits everything.
        // It holds a button so the slot has geometry a drag can be released over.
        ['id' => 'ctaa00000001', 'type' => 'cta', 'data' => [
            'title' => 'Ready to begin?',
            'links' => [
                ['id' => 'ctabutn0001', 'type' => 'button',
                    'data' => ['label' => 'Start', 'url' => '/start'], 'settings' => []],
            ],
        ], 'settings' => []],
        // The grid on the stage (container-layout spec §11.2): an empty grid, whose tracks are
        // outlined from the start with the placeholder in the first, and one whose child spans
        // two of its three tracks, leaving a cell free.
        ['id' => 'gridempty001', 'type' => 'container', 'data' => ['element' => 'div', 'content' => []],
            'settings' => ['style' => ['layout' => [
                'display' => ['base' => ['type' => 'choice', 'value' => 'grid']],
                // One track below md and three from it: resizing the stage across md changes the
                // number of cells the outline has to draw, not only where they are.
                'columns' => [
                    'base' => ['type' => 'choice', 'value' => '1'],
                    'md' => ['type' => 'choice', 'value' => '3'],
                ],
                'content_width' => ['base' => ['type' => 'token', 'value' => 'width.container']],
            ]]]],
        ['id' => 'gridspan0001', 'type' => 'container', 'data' => ['element' => 'div', 'content' => [
            ['id' => 'gridspanh001', 'type' => 'heading', 'data' => ['text' => 'Spans two'],
                'settings' => ['style' => ['layout' => [
                    'span' => ['base' => ['type' => 'choice', 'value' => '2']],
                ]]]],
        ]], 'settings' => ['style' => ['layout' => [
            'display' => ['base' => ['type' => 'choice', 'value' => 'grid']],
            'columns' => ['base' => ['type' => 'choice', 'value' => '3']],
            'content_width' => ['base' => ['type' => 'token', 'value' => 'width.container']],
        ]]]],
        // Last, so no proof that counts or indexes the blocks above it moves: a prose body, for
        // the Block tab's editor and its hand-over with the stage (inspector-content.spec.ts).
        ['id' => 'prose0000001', 'type' => 'rich_text', 'data' => ['body' => '<p>Written once.</p>'],
            'settings' => []],
    ]],
    (int) $page['schema_version'],
    (int) ($draft['lock_version'] ?? 0),
    null,
);

$json = static function (string $name, string $body) use ($out): void {
    file_put_contents($out . '/api/' . $name . '.json', $body);
};
$get = static fn (string $path): Request => Request::create($path, 'GET');
$post = static fn (string $path): Request => Request::create($path, 'POST', [], [], [], ['CONTENT_TYPE' => 'application/json'], '{}');

$json('content-types', (string) $container->get(ContentTypeController::class)->index($get('/x'))->getContent());
$json('block-types', (string) $container->get(BlockTypeController::class)->index($get('/x'))->getContent());
$json('patterns', (string) $container->get(\Thallo\Core\Content\Http\Controllers\PatternController::class)->index(Request::create('/x'))->getContent());
$json('draft', (string) $container->get(EntryController::class)->getDraft($get('/x'), $entryUuid, 'en')->getContent());
$json('style-schema', (string) $container->get(StyleSchemaController::class)->show()->getContent());
$json('style-classes', (string) $container->get(StyleClassController::class)->index($get('/x'))->getContent());
$json('capabilities', (string) $container->get(CapabilityAdminController::class)->index()->getContent());
// The Search block's scope choices, as GET /field-options/thallo-search.scopes answers an author.
$scopes = $container->get(\Thallo\Contracts\Fields\FieldOptionSourceRegistry::class)->find('thallo-search.scopes');
if ($scopes === null) {
    fwrite(STDERR, "the thallo-search.scopes option source is not registered: is Search on?\n");
    exit(1);
}
$json('field-options-thallo-search.scopes', (string) json_encode(
    ['success' => true, 'message' => 'Success', 'data' => ['options' => $scopes->options()]],
    JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR,
));
$json('config', json_encode([
    'apiBase' => '/v1/admin',
    'sitePreviewUrl' => '',
    'defaultLocale' => 'en',
    'installed' => true,
    'apiDocsPath' => '/api-docs',
], JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR));
$json('login', json_encode([
    'success' => true,
    'message' => 'Signed in.',
    'data' => [
        'access_token' => 'builder-proof-access',
        'refresh_token' => 'builder-proof-refresh',
        'user' => ['uuid' => 'proofuser001', 'email' => 'proofs@thallo.test'],
    ],
], JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR));

$mint = $container->get(PreviewController::class)->mint(new MintPreviewData(), $post('/x'), $entryUuid, 'en');
$json('mint', (string) $mint->getContent());
$token = (string) (json_decode((string) $mint->getContent(), true)['data']['token'] ?? '');
if ($token === '') {
    fwrite(STDERR, "mint returned no token\n");
    exit(1);
}
$rendered = $container->get(RenderController::class)->preview(
    Request::create('/_preview/' . $token . '?canvas=1', 'GET'),
    $token,
);
if ($rendered->getStatusCode() !== 200) {
    fwrite(STDERR, "canvas render returned {$rendered->getStatusCode()}\n");
    exit(1);
}
file_put_contents($out . '/canvas.html', (string) $rendered->getContent());

// The stylesheets the canvas links, built from the real theme (as scripts/build-style-proof-fixtures
// does): the proofs serve them in place of the app's asset routes, so slots keep their real layout.
$theme = new ThemeLocator('default', $root . '/themes');
$vocabulary = $theme->vocabulary();
$themeDir = $theme->themeDir();
$files = array_map(static fn (string $rel): string => $themeDir . '/' . $rel, $vocabulary->stylesheets());
file_put_contents($out . '/layers.css', file_get_contents($root . '/packages/thallo-render/assets/style/layers.css'));
// With the packs' contributed stylesheets, as the app builds it (ThemeStylesheetArtifacts): the shop's
// stylesheet reaches a shop layout's stage through this artifact alone (type layouts plan C2).
file_put_contents($out . '/theme.css', ThemeStylesheetArtifact::build(
    $files,
    $container->get(Thallo\Render\Contribution\RenderContributionRegistry::class)->frozenStylesheets(),
)->css);
file_put_contents($out . '/settings.css', StyleCompiler::compile($vocabulary));
file_put_contents($out . '/entry.json', json_encode(['uuid' => $entryUuid, 'locale' => 'en', 'type' => 'page'], JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR));

// ── The regions stage (regions stage plan R8) ─────────────────────────────────────────────────
// Two published pages (the homepage and `pageb`) and saved header and footer regions, then every
// accepted state the proofs reach — authored once in admin/e2e/regions-scenarios.json — rendered
// through the real session → apply → preview path. Each state is validated as a save would be and
// must come out of the validator unchanged, so a proof matching the editor's accepted document
// against a scenario matches exactly what the stage shows. The seeding runs in one transaction
// that is rolled back: the test database keeps no regions, pages or homepage from this run.
$regionsOut = $out . '/regions';
if (!is_dir($regionsOut) && !mkdir($regionsOut, 0755, true)) {
    fwrite(STDERR, "cannot create {$regionsOut}\n");
    exit(1);
}
$scenarios = json_decode(
    (string) file_get_contents($root . '/admin/e2e/regions-scenarios.json'),
    true,
    512,
    JSON_THROW_ON_ERROR,
)['scenarios'];

/** Thrown to roll the regions seeding back once its fixtures are written. */
final class RegionFixturesWritten extends RuntimeException
{
}

/** Keys sorted all the way down, so two documents compare by content. */
$canonical = static function (mixed $value) use (&$canonical): mixed {
    if (!is_array($value)) {
        return $value;
    }
    if (!array_is_list($value)) {
        ksort($value);
    }
    return array_map($canonical, $value);
};

$db = $container->get(Glueful\Database\Connection::class);
try {
    $db->transaction(static function () use ($container, $contentTypes, $pageUuid, $entries, $page, $scenarios, $regionsOut, $out, $canonical): void {
        $contentTypes->updateMeta($pageUuid, ['public_delivery' => true]);
        // Published directly, as the render tests publish: no workflow gate stands between a proof
        // fixture and its page.
        $context = TestApplication::instance()->getContext();
        $db = $container->get(Glueful\Database\Connection::class);
        $publisher = new Thallo\Core\Content\Services\PublishService(
            $context,
            $entries,
            new Thallo\Core\Content\Repositories\VersionRepository($db),
            $contentTypes,
            new Thallo\Core\Content\Validation\FieldValidator($db, $context, new BlockTypeRepository($db)),
            new Thallo\Core\Content\Repositories\ReferenceProjectionRepository($db),
        );
        $routes = $container->get(Thallo\Core\Content\Repositories\RouteRepository::class);
        $pages = [];
        foreach (['home' => 'Home', 'pageb' => 'Page B'] as $name => $title) {
            $uuid = $entries->createEntry($pageUuid, 'en', (int) $page['schema_version'], null);
            $entries->saveDraft($uuid, 'en', ['title' => $title, 'body' => [
                // A body link: the stage keeps it inert (regions-stage.spec.ts).
                ['id' => "e2ebody{$name}", 'type' => 'rich_text', 'data' => [
                    'body' => "<p>{$title} body. <a href=\"/elsewhere\" id=\"e2e-body-link\">A body link</a></p>",
                ], 'settings' => []],
            ]], (int) $page['schema_version'], 0, null);
            $routes->assign($uuid, $pageUuid, 'en', "e2e-{$name}");
            $publisher->publish($uuid, 'en', null);
            $pages[$name] = $uuid;
        }
        $container->get(Thallo\Core\Settings\SettingsStore::class)->putMany(['homepage_entry' => $pages['home']]);
        // The header's navigation shows a real menu, so it has geometry a drag can use. Items go in
        // through the connection: the repository's tree write opens a transaction of its own.
        $menu = $container->get(Thallo\Navigation\MenuRepository::class)->createMenu('e2e-main', 'Main');
        $now = gmdate('Y-m-d H:i:s');
        foreach ([['e2enavitem01', 'Pricing', '/pricing'], ['e2enavitem02', 'Docs', '/docs']] as $i => [$id, $label, $url]) {
            $db->table('navigation_items')->insert([
                'uuid' => $id, 'menu_uuid' => $menu['uuid'], 'parent_uuid' => null, 'position' => $i,
                'kind' => 'url', 'entry_uuid' => null, 'url' => $url, 'icon' => null, 'new_tab' => false,
                'labels' => json_encode(['en' => $label], JSON_THROW_ON_ERROR), 'descriptions' => null,
                'created_at' => $now, 'updated_at' => $now,
            ]);
        }

        // `{id, $factory: slug}` is that type's factory instance under the given id: the block the
        // palette tile inserts (defaults, starter over them, the type's settings).
        $factory = $container->get(Thallo\Core\Content\Blocks\BlockFactory::class);
        $instances = [];
        $expand = static function (array $blocks) use (&$expand, $factory, &$instances): array {
            $out = [];
            foreach ($blocks as $block) {
                if (isset($block['$factory'])) {
                    $slug = (string) $block['$factory'];
                    $made = $factory->make($slug) ?? throw new RuntimeException("no block type '{$slug}'");
                    $instances[$slug] = ['block' => $made['block'], 'starter' => $made['starter']];
                    $block = [
                        'id' => $block['id'],
                        'type' => $made['block']['type'],
                        'data' => array_merge($made['block']['data'], $made['starter']),
                        'settings' => $made['block']['settings'],
                    ];
                }
                foreach ($block['data'] ?? [] as $key => $value) {
                    if (is_array($value) && array_is_list($value) && $value !== [] && is_array($value[0]) && (isset($value[0]['type']) || isset($value[0]['$factory']))) {
                        $block['data'][$key] = $expand($value);
                    }
                }
                $out[] = $block;
            }
            return $out;
        };

        $validator = $container->get(Thallo\Core\Content\Regions\RegionValidator::class);
        $documents = [];
        foreach ($scenarios as $scenario) {
            $doc = $scenario['document'];
            foreach (['header', 'footer'] as $slug) {
                $doc[$slug]['blocks'] = $expand($doc[$slug]['blocks']);
            }
            try {
                $clean = $validator->validateBoth($doc);
            } catch (Thallo\Core\Content\Validation\ValidationException $e) {
                fwrite(STDERR, "scenario '{$scenario['name']}' is invalid: " . json_encode($e->errors()) . "\n");
                exit(1);
            }
            if (json_encode($canonical($clean)) !== json_encode($canonical($doc))) {
                fwrite(STDERR, "scenario '{$scenario['name']}' does not survive validation unchanged:\n  authored "
                    . json_encode($canonical($doc)) . "\n  clean    " . json_encode($canonical($clean)) . "\n");
                exit(1);
            }
            $documents[$scenario['name']] = $doc;
        }

        $regions = $container->get(Thallo\Core\Content\Regions\RegionRepository::class);
        $saveRows = static function (array $doc) use ($regions): void {
            foreach (['header', 'footer'] as $slug) {
                $regions->save($slug, $doc[$slug]['blocks'], $doc[$slug]['settings'], null);
            }
        };
        $sessionOf = static function (?string $pageUuid) use ($container): array {
            $dto = (new Glueful\Validation\RequestDataHydrator())->hydrate(
                Thallo\Core\Http\DTOs\RegionSessionData::class,
                ['page' => $pageUuid],
            );
            $body = (string) $container->get(Thallo\Core\Http\Controllers\RegionPreviewController::class)->session($dto)->getContent();
            return [$body, json_decode($body, true, 512, JSON_THROW_ON_ERROR)['data']];
        };
        $write = static fn (string $name, string $body) => file_put_contents($regionsOut . '/' . $name, $body);

        // The saved regions are the baseline: the page opens on them, and the regions list says so.
        $saveRows($documents['baseline']);
        [$body] = $sessionOf(null);
        $write('session.json', $body);
        $write('regions.json', (string) $container->get(Thallo\Core\Http\Controllers\RegionAdminController::class)->index()->getContent());
        // The container proof starts from its own session, whose baseline is `container`.
        $saveRows($documents['container']);
        [$body] = $sessionOf(null);
        $write('session-container.json', $body);
        $saveRows($documents['baseline']);

        // One session per state: mint for its page, apply its document, render the stage.
        $stages = [];
        foreach ($scenarios as $scenario) {
            $name = (string) $scenario['name'];
            [, $session] = $sessionOf($pages[$scenario['page']]);
            $dto = (new Glueful\Validation\RequestDataHydrator())->hydrate(Thallo\Core\Http\DTOs\ApplyRegionsData::class, [
                'token' => $session['token'],
                'regions' => $documents[$name],
                'epoch' => null,
                'base_revision' => null,
            ]);
            $applied = $container->get(Thallo\Core\Http\Controllers\RegionPreviewController::class)->apply($dto);
            if ($applied->getStatusCode() !== 200) {
                fwrite(STDERR, "applying '{$name}' returned {$applied->getStatusCode()}: {$applied->getContent()}\n");
                exit(1);
            }
            $token = (string) $session['token'];
            $rendered = $container->get(RenderController::class)->preview(
                Request::create('/_preview/' . $token . '?canvas=1', 'GET'),
                $token,
            );
            if ($rendered->getStatusCode() !== 200) {
                fwrite(STDERR, "the '{$name}' stage returned {$rendered->getStatusCode()}\n");
                exit(1);
            }
            $write("stage-{$name}.html", (string) $rendered->getContent());
            $stages[$name] = ['page' => $scenario['page'], 'document' => $documents[$name], 'file' => "stage-{$name}.html"];
        }
        $write('stages.json', json_encode($stages, JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR));
        $write('pages.json', json_encode($pages, JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR));
        foreach ($instances as $slug => $instance) {
            file_put_contents(
                $out . "/api/instance-{$slug}.json",
                json_encode(['success' => true, 'data' => $instance], JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR),
            );
        }
        throw new RegionFixturesWritten();
    });
} catch (RegionFixturesWritten) {
    // Written, and rolled back.
}

// ── The layout stage (type layouts plan L9) ───────────────────────────────────────────────────
// A publicly delivered `post` type with one published post, and its layout saved once, then every
// accepted state the proofs reach — authored once in admin/e2e/layouts-scenarios.json — rendered
// through the real session → apply → preview path around that post. Each state must come out of
// the validator unchanged. The seeding runs in one transaction that is rolled back.
$layoutsOut = $out . '/layouts';
if (!is_dir($layoutsOut) && !mkdir($layoutsOut, 0755, true)) {
    fwrite(STDERR, "cannot create {$layoutsOut}\n");
    exit(1);
}
$layoutScenarios = json_decode(
    (string) file_get_contents($root . '/admin/e2e/layouts-scenarios.json'),
    true,
    512,
    JSON_THROW_ON_ERROR,
)['scenarios'];

/** Thrown to roll the layout seeding back once its fixtures are written. */
final class LayoutFixturesWritten extends RuntimeException
{
}

try {
    $db->transaction(static function () use ($container, $contentTypes, $entries, $layoutScenarios, $layoutsOut, $out, $canonical, $pageUuid, $entryUuid): void {
        $context = TestApplication::instance()->getContext();
        $db = $container->get(Glueful\Database\Connection::class);
        $postType = $contentTypes->findBySlug('post')['uuid'] ?? $contentTypes->create([
            'slug' => 'post', 'name' => 'Posts', 'public_delivery' => true, 'schema' => [
                ['name' => 'title', 'type' => 'string', 'required' => true],
                ['name' => 'body', 'type' => 'blocks'],
            ],
        ]);
        $contentTypes->updateMeta((string) $postType, ['public_delivery' => true]);
        $post = $contentTypes->findByUuid((string) $postType);
        $publisher = new Thallo\Core\Content\Services\PublishService(
            $context,
            $entries,
            new Thallo\Core\Content\Repositories\VersionRepository($db),
            $contentTypes,
            new Thallo\Core\Content\Validation\FieldValidator($db, $context, new BlockTypeRepository($db)),
            new Thallo\Core\Content\Repositories\ReferenceProjectionRepository($db),
        );
        $sample = $entries->createEntry((string) $postType, 'en', (int) $post['schema_version'], null);
        $entries->saveDraft($sample, 'en', ['title' => 'A sample post', 'body' => [
            ['id' => 'e2epostbody1', 'type' => 'rich_text', 'data' => [
                'body' => '<p>The post’s own words, inside the layout.</p>',
            ], 'settings' => []],
        ]], (int) $post['schema_version'], 0, null);
        $container->get(Thallo\Core\Content\Repositories\RouteRepository::class)
            ->assign($sample, (string) $postType, 'en', 'e2e-sample-post');
        $publisher->publish($sample, 'en', null);

        $factory = $container->get(Thallo\Core\Content\Blocks\BlockFactory::class);
        $instances = [];
        $expand = static function (array $blocks) use ($factory, &$instances): array {
            $made = [];
            foreach ($blocks as $block) {
                if (isset($block['$factory'])) {
                    $slug = (string) $block['$factory'];
                    $built = $factory->make($slug) ?? throw new RuntimeException("no block type '{$slug}'");
                    $instances[$slug] = ['block' => $built['block'], 'starter' => $built['starter']];
                    $block = [
                        'id' => $block['id'],
                        'type' => $built['block']['type'],
                        'data' => array_merge($built['block']['data'], $built['starter']),
                        'settings' => $built['block']['settings'],
                    ];
                }
                $made[] = $block;
            }
            return $made;
        };

        $validator = $container->get(Thallo\Core\Content\Layouts\LayoutValidator::class);
        $documents = [];
        foreach ($layoutScenarios as $scenario) {
            $layout = $scenario['layout'];
            $layout['blocks'] = $expand($layout['blocks']);
            try {
                $clean = $validator->validate('entry', 'post', $layout['blocks'], $layout['settings']);
            } catch (Thallo\Core\Content\Validation\ValidationException $e) {
                fwrite(STDERR, "layout scenario '{$scenario['name']}' is invalid: " . json_encode($e->errors()) . "\n");
                exit(1);
            }
            if (json_encode($canonical($clean)) !== json_encode($canonical($layout))) {
                fwrite(STDERR, "layout scenario '{$scenario['name']}' does not survive validation unchanged:\n  authored "
                    . json_encode($canonical($layout)) . "\n  clean    " . json_encode($canonical($clean)) . "\n");
                exit(1);
            }
            $documents[$scenario['name']] = $layout;
        }

        // The layout editor's library for this post type (sections and templates design §4), and two
        // accepted states it reaches: the Previous / next section inserted after the baseline, and the
        // Full width template in its place — built from what the library serves, with the ids the proof
        // queues in the order the admin mints them (the block first, then each nested list), so the
        // stage for each is the real render of exactly that document (layout-patterns.spec.ts).
        $library = (string) $container->get(\Thallo\Core\Content\Http\Controllers\PatternController::class)
            ->index(Request::create('/x', 'GET', ['surface' => 'entry', 'target' => 'post']))->getContent();
        file_put_contents($out . '/api/patterns-layout-entry-post.json', $library);
        $served = array_column(json_decode($library, true, 512, JSON_THROW_ON_ERROR)['data']['patterns'], null, 'slug');
        $mint = static function (array $blocks, string $prefix, int &$n, array &$ids) use (&$mint): array {
            $out = [];
            foreach ($blocks as $block) {
                $id = $prefix . str_pad((string) ++$n, 12 - strlen($prefix), '0', STR_PAD_LEFT);
                $ids[] = $id;
                $data = [];
                foreach ($block['data'] as $key => $value) {
                    $data[$key] = is_array($value) && array_is_list($value) && $value !== [] && isset($value[0]['type'])
                        ? $mint($value, $prefix, $n, $ids)
                        : $value;
                }
                $out[] = ['id' => $id, 'type' => $block['type'], 'data' => $data, 'settings' => $block['settings']];
            }
            return $out;
        };
        $queued = [];
        foreach (['entry-neighbours' => 'neighbours', 'entry-page-full' => 'fullwidth'] as $slug => $prefix) {
            if (!isset($served[$slug])) {
                fwrite(STDERR, "the layout library for posts does not serve '{$slug}'\n");
                exit(1);
            }
            $n = 0;
            $ids = [];
            $minted = $mint($served[$slug]['blocks'], $prefix, $n, $ids);
            $queued[$slug] = $ids;
            $generated = $slug === 'entry-neighbours'
                ? ['name' => 'with-neighbours', 'layout' => [
                    'blocks' => [...$documents['baseline']['blocks'], ...$minted],
                    'settings' => [],
                ]]
                : ['name' => 'full-width', 'layout' => [
                    'blocks' => $minted,
                    'settings' => (array) $served[$slug]['settings'],
                ]];
            try {
                $clean = $validator->validate('entry', 'post', $generated['layout']['blocks'], $generated['layout']['settings']);
            } catch (Thallo\Core\Content\Validation\ValidationException $e) {
                fwrite(STDERR, "generated layout '{$generated['name']}' is invalid: " . json_encode($e->errors()) . "\n");
                exit(1);
            }
            if (json_encode($canonical($clean)) !== json_encode($canonical($generated['layout']))) {
                fwrite(STDERR, "generated layout '{$generated['name']}' does not survive validation unchanged\n");
                exit(1);
            }
            $documents[$generated['name']] = $generated['layout'];
            $layoutScenarios[] = $generated;
        }
        file_put_contents($out . '/api/layout-template-ids.json', json_encode($queued, JSON_PRETTY_PRINT));

        // The baseline is the saved layout, at version 1: the editor opens on it.
        $repo = $container->get(Thallo\Core\Content\Layouts\LayoutRepository::class);
        $container->get(Thallo\Core\Content\Layouts\LayoutWriteLock::class)->within(
            'entry',
            'post',
            fn (): int => $repo->saveExpected('entry', 'post', $documents['baseline']['blocks'], [], 0, null),
        );
        $container->get(Thallo\Core\Content\Layouts\LayoutResolver::class)->forget('entry', 'post');

        $write = static fn (string $name, string $body) => file_put_contents($layoutsOut . '/' . $name, $body);
        $sessionOf = static function () use ($container, $sample): array {
            $dto = (new Glueful\Validation\RequestDataHydrator())->hydrate(
                Thallo\Core\Http\DTOs\LayoutSessionData::class,
                ['surface' => 'entry', 'target' => 'post', 'sample' => $sample],
            );
            $body = (string) $container->get(Thallo\Core\Http\Controllers\LayoutPreviewController::class)
                ->session($dto)->getContent();
            return [$body, json_decode($body, true, 512, JSON_THROW_ON_ERROR)['data']];
        };
        [$body] = $sessionOf();
        $write('session.json', $body);
        $admin = $container->get(Thallo\Core\Http\Controllers\LayoutAdminController::class);
        $write('layouts.json', (string) $admin->index(Request::create('/v1/layouts', 'GET'))->getContent());
        $write('samples.json', (string) $admin->samples(Request::create('/x'), 'entry', 'post')->getContent());

        $stages = [];
        foreach ($layoutScenarios as $scenario) {
            $name = (string) $scenario['name'];
            [, $session] = $sessionOf();
            $dto = (new Glueful\Validation\RequestDataHydrator())->hydrate(Thallo\Core\Http\DTOs\ApplyLayoutData::class, [
                'token' => $session['token'],
                'layout' => $documents[$name],
                'epoch' => null,
                'base_revision' => null,
            ]);
            $applied = $container->get(Thallo\Core\Http\Controllers\LayoutPreviewController::class)->apply($dto);
            if ($applied->getStatusCode() !== 200) {
                fwrite(STDERR, "applying layout '{$name}' returned {$applied->getStatusCode()}: {$applied->getContent()}\n");
                exit(1);
            }
            $token = (string) $session['token'];
            $rendered = $container->get(RenderController::class)->preview(
                Request::create('/_preview/' . $token . '?canvas=1', 'GET'),
                $token,
            );
            if ($rendered->getStatusCode() !== 200) {
                fwrite(STDERR, "the '{$name}' layout stage returned {$rendered->getStatusCode()}\n");
                exit(1);
            }
            $write("stage-{$name}.html", (string) $rendered->getContent());
            $stages[$name] = ['layout' => $documents[$name], 'file' => "stage-{$name}.html"];
        }
        $write('stages.json', json_encode($stages, JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR));

        // The Design view under a layout (type layouts plan L10): the composition entry's type gets
        // a layout — a heading of its own around the entry's body — and the entry's canvas is
        // rendered as the Design view shows it then, with the mint that names the layout.
        $contentTypes->updateMeta($pageUuid, ['public_delivery' => true]);
        $pageLayout = [
            ['id' => 'e2elayouthd1', 'type' => 'heading', 'data' => ['text' => 'A heading the layout adds'], 'settings' => []],
            ['id' => 'e2elayoutbd1', 'type' => 'entry_content', 'data' => ['field' => 'body'], 'settings' => []],
        ];
        $container->get(Thallo\Core\Content\Layouts\LayoutWriteLock::class)->within(
            'entry',
            'page',
            fn (): int => $repo->saveExpected('entry', 'page', $pageLayout, [], $repo->version('entry', 'page'), null),
        );
        $container->get(Thallo\Core\Content\Layouts\LayoutResolver::class)->forget('entry', 'page');
        $mint = $container->get(PreviewController::class)
            ->mint(new MintPreviewData(), Request::create('/x', 'POST'), $entryUuid, 'en');
        $mintBody = json_decode((string) $mint->getContent(), true, 512, JSON_THROW_ON_ERROR);
        if (($mintBody['data']['layout']['target'] ?? null) !== 'page') {
            fwrite(STDERR, "the entry mint under a layout named no layout: {$mint->getContent()}\n");
            exit(1);
        }
        $write('entry-mint.json', (string) $mint->getContent());
        $entryToken = (string) $mintBody['data']['token'];
        $canvas = $container->get(RenderController::class)->preview(
            Request::create('/_preview/' . $entryToken . '?canvas=1', 'GET'),
            $entryToken,
        );
        if ($canvas->getStatusCode() !== 200) {
            fwrite(STDERR, "the entry canvas under a layout returned {$canvas->getStatusCode()}\n");
            exit(1);
        }
        $write('canvas-under-layout.html', (string) $canvas->getContent());
        $container->get(Thallo\Core\Content\Layouts\LayoutResolver::class)->forget('entry', 'page');

        // The product layout's stage (type layouts plan C1, P7): one active product, a product layout
        // session on the starter, and two rendered states — the starter, and the starter with a
        // Product rating of id `e2eratingnew` directly after the name, as the proof drags it in. The
        // proof is served the rated stage only for exactly that document.
        $productSeed = new Thallo\Core\Tests\Support\ProductPageSeed($container, $context);
        $previousTenant = $productSeed->useTenant();
        try {
            $container->get(Glueful\Extensions\Commerce\Catalog\CatalogService::class)->createProduct($context, [
                'slug' => 'linen-lamp', 'name' => 'Linen table lamp', 'status' => 'active', 'type' => 'digital',
                'variants' => [['sku' => 'proof-lamp-1', 'price' => 8900, 'currency' => 'USD', 'option_values' => []]],
            ]);
            $productSession = static function () use ($container): array {
                $dto = (new Glueful\Validation\RequestDataHydrator())->hydrate(
                    Thallo\Core\Http\DTOs\LayoutSessionData::class,
                    ['surface' => 'product', 'target' => '@site'],
                );
                $body = (string) $container->get(Thallo\Core\Http\Controllers\LayoutPreviewController::class)
                    ->session($dto)->getContent();
                return [$body, json_decode($body, true, 512, JSON_THROW_ON_ERROR)['data']];
            };
            [$body, $opened] = $productSession();
            $write('product-session.json', $body);
            $write(
                'product-samples.json',
                (string) $admin->samples(Request::create('/x'), 'product', '@site')->getContent(),
            );

            $made = $factory->make('product_rating') ?? throw new RuntimeException("no block type 'product_rating'");
            $instances['product_rating'] = ['block' => $made['block'], 'starter' => $made['starter']];
            $rating = [
                'id' => 'e2eratingnew',
                'type' => 'product_rating',
                'data' => array_merge($made['block']['data'], $made['starter']),
                'settings' => $made['block']['settings'],
            ];
            $afterName = static function (array $blocks) use (&$afterName, $rating): array {
                $out = [];
                foreach ($blocks as $block) {
                    foreach ($block['data'] as $key => $value) {
                        if (is_array($value) && array_is_list($value) && isset($value[0]['type'])) {
                            $block['data'][$key] = $afterName($value);
                        }
                    }
                    $out[] = $block;
                    if ($block['type'] === 'product_name') {
                        $out[] = $rating;
                    }
                }
                return $out;
            };
            $baseline = ['blocks' => $opened['layout']['blocks'], 'settings' => $opened['layout']['settings']];
            $productStages = [];
            foreach (['baseline' => $baseline, 'rated' => ['blocks' => $afterName($baseline['blocks'])] + $baseline] as $name => $document) {
                // A starter's ids are made at each mint: every state, the baseline too, is applied, so
                // the stage carries the ids of the session the proof opens.
                [, $session] = $productSession();
                $token = (string) $session['token'];
                $dto = (new Glueful\Validation\RequestDataHydrator())->hydrate(Thallo\Core\Http\DTOs\ApplyLayoutData::class, [
                    'token' => $token, 'layout' => $document, 'epoch' => null, 'base_revision' => null,
                ]);
                $applied = $container->get(Thallo\Core\Http\Controllers\LayoutPreviewController::class)->apply($dto);
                if ($applied->getStatusCode() !== 200) {
                    throw new RuntimeException("applying the product '{$name}' layout returned {$applied->getStatusCode()}: {$applied->getContent()}");
                }
                $rendered = $container->get(RenderController::class)->preview(
                    Request::create('/_preview/' . $token . '?canvas=1', 'GET'),
                    $token,
                );
                if ($rendered->getStatusCode() !== 200 || !str_contains((string) $rendered->getContent(), 'shop-product--layout')) {
                    throw new RuntimeException("the product '{$name}' stage is not the product frame ({$rendered->getStatusCode()})");
                }
                $write("product-stage-{$name}.html", (string) $rendered->getContent());
                $productStages[$name] = ['layout' => $document, 'file' => "product-stage-{$name}.html"];
            }
            $write('product-stages.json', json_encode($productStages, JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR));
        } finally {
            $productSeed->restoreTenant($previousTenant);
        }
        foreach ($instances as $slug => $instance) {
            file_put_contents(
                $out . "/api/instance-{$slug}.json",
                json_encode(['success' => true, 'data' => $instance], JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR),
            );
        }
        throw new LayoutFixturesWritten();
    });
} catch (LayoutFixturesWritten) {
    // Written, and rolled back.
} catch (Throwable $e) {
    // Left to the framework's handler, a throw prints its JSON and exits 0: CI would run the proofs
    // on the fixtures written before it.
    fwrite(STDERR, 'the layout fixtures failed: ' . $e::class . ': ' . $e->getMessage() . "\n");
    exit(1);
}

// ── The listing layout's stage (type layouts plan B, B6) ─────────────────────────────────────────
// The post listing's layout, saved once as the baseline, and every accepted state the proofs reach
// — authored once in admin/e2e/listing-scenarios.json — rendered through the real session → apply
// → preview path around the listing's first page (ListingPageSeed, RENDER_LISTING_PER_PAGE's two
// posts). The `placeholder` state is rendered in a world of its own: the post type listed with
// nothing published, whose stage shows the placeholder page's one sample card. Each state must come
// out of the validator unchanged. Each world is seeded in a transaction that is rolled back.
$listingScenarios = json_decode(
    (string) file_get_contents($root . '/admin/e2e/listing-scenarios.json'),
    true,
    512,
    JSON_THROW_ON_ERROR,
)['scenarios'];

try {
    $db->transaction(static function () use ($container, $contentTypes, $listingScenarios, $layoutsOut, $out, $canonical): void {
        $context = TestApplication::instance()->getContext();
        $write = static fn (string $name, string $body) => file_put_contents($layoutsOut . '/' . $name, $body);
        $factory = $container->get(Thallo\Core\Content\Blocks\BlockFactory::class);
        $preview = $container->get(Thallo\Core\Http\Controllers\LayoutPreviewController::class);
        $repo = $container->get(Thallo\Core\Content\Layouts\LayoutRepository::class);
        $resolver = $container->get(Thallo\Core\Content\Layouts\LayoutResolver::class);
        $lock = $container->get(Thallo\Core\Content\Layouts\LayoutWriteLock::class);
        $validator = $container->get(Thallo\Core\Content\Layouts\LayoutValidator::class);
        $db = $container->get(Glueful\Database\Connection::class);

        // A database that already holds these types (a local one, between runs) keeps them aside
        // for the transaction: the seed makes its own.
        foreach (['post', 'category'] as $slug) {
            $db->table('content_types')->where('slug', '=', $slug)->update(['slug' => $slug . '-e2e-aside']);
        }

        $instances = [];
        $expand = static function (array $blocks) use (&$expand, $factory, &$instances): array {
            $made = [];
            foreach ($blocks as $block) {
                if (isset($block['$factory'])) {
                    $slug = (string) $block['$factory'];
                    $built = $factory->make($slug) ?? throw new RuntimeException("no block type '{$slug}'");
                    $instances[$slug] = ['block' => $built['block'], 'starter' => $built['starter']];
                    $block = [
                        'id' => $block['id'],
                        'type' => $built['block']['type'],
                        'data' => array_merge($built['block']['data'], $built['starter']),
                        'settings' => $built['block']['settings'],
                    ];
                }
                foreach ($block['data'] as $key => $value) {
                    if (is_array($value) && array_is_list($value) && ($value === [] || isset($value[0]['type']) || isset($value[0]['$factory']))) {
                        $block['data'][$key] = $expand($value);
                    }
                }
                $made[] = $block;
            }
            return $made;
        };
        $session = static function () use ($preview): array {
            $dto = (new Glueful\Validation\RequestDataHydrator())->hydrate(
                Thallo\Core\Http\DTOs\LayoutSessionData::class,
                ['surface' => 'listing', 'target' => 'post'],
            );
            $body = (string) $preview->session($dto)->getContent();
            return [$body, json_decode($body, true, 512, JSON_THROW_ON_ERROR)['data']];
        };
        $render = static function (array $document, string $name) use ($container, $preview, $session): string {
            [, $opened] = $session();
            $token = (string) $opened['token'];
            $dto = (new Glueful\Validation\RequestDataHydrator())->hydrate(Thallo\Core\Http\DTOs\ApplyLayoutData::class, [
                'token' => $token, 'layout' => $document, 'epoch' => null, 'base_revision' => null,
            ]);
            $applied = $preview->apply($dto);
            if ($applied->getStatusCode() !== 200) {
                throw new RuntimeException("applying the listing '{$name}' layout returned {$applied->getStatusCode()}: {$applied->getContent()}");
            }
            $rendered = $container->get(RenderController::class)->preview(
                Request::create('/_preview/' . $token . '?canvas=1', 'GET'),
                $token,
            );
            $html = (string) $rendered->getContent();
            if ($rendered->getStatusCode() !== 200 || !str_contains($html, 'thallo-layout--listing')) {
                throw new RuntimeException("the listing '{$name}' stage is not the listing frame ({$rendered->getStatusCode()})");
            }
            return $html;
        };
        $saveBaseline = static function (array $document) use ($repo, $resolver, $lock): void {
            $lock->within(
                'listing',
                'post',
                fn (): int => $repo->saveExpected('listing', 'post', $document['blocks'], $document['settings'], $repo->version('listing', 'post'), null),
            );
            $resolver->forget('listing', 'post');
        };

        // The placeholder world first: the post type listed, nothing published.
        $contentTypes->create([
            'slug' => 'post', 'name' => 'Posts', 'public_delivery' => true, 'schema' => [
                ['name' => 'title', 'type' => 'string', 'required' => true],
            ],
        ]);
        $container->get(Thallo\Core\Settings\GeneralSettings::class)->save(['listing_types' => ['post']]);
        $documents = [];
        foreach ($listingScenarios as $scenario) {
            $documents[(string) $scenario['name']] = ['blocks' => $expand($scenario['layout']['blocks'])] + $scenario['layout'];
        }
        $placeholders = array_values(array_filter($listingScenarios, static fn (array $s): bool => ($s['placeholder'] ?? false) === true));
        foreach ($placeholders as $scenario) {
            $name = (string) $scenario['name'];
            $saveBaseline($documents[$name]);
            [$body, $opened] = $session();
            if ($opened['placeholder'] !== true) {
                throw new RuntimeException("the listing '{$name}' session is not a placeholder session");
            }
            $write('listing-placeholder-session.json', $body);
            $write(
                'listing-placeholder-samples.json',
                (string) $container->get(Thallo\Core\Http\Controllers\LayoutAdminController::class)
                    ->samples(Request::create('/x'), 'listing', 'post')->getContent(),
            );
            $html = $render($documents[$name], $name);
            if (!str_contains($html, 'data-thallo-placeholder')) {
                throw new RuntimeException("the listing '{$name}' stage shows no placeholder");
            }
            $write("listing-stage-{$name}.html", $html);
            // The placeholder world's stages: its one state is the one it opens on.
            $write('listing-placeholder-stages.json', json_encode(
                ['baseline' => ['layout' => $documents[$name], 'file' => "listing-stage-{$name}.html"]],
                JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR,
            ));
        }
        $db->table('layouts')->where('surface', '=', 'listing')->delete();
        $db->table('content_types')->where('slug', '=', 'post')->update(['slug' => 'post-e2e-empty']);

        // The sampled world: three published posts in Pottery, two to a page.
        (new Thallo\Core\Tests\Support\ListingPageSeed($container, $context))->seed();
        foreach ($listingScenarios as $scenario) {
            $name = (string) $scenario['name'];
            try {
                $clean = $validator->validate('listing', 'post', $documents[$name]['blocks'], $documents[$name]['settings']);
            } catch (Thallo\Core\Content\Validation\ValidationException $e) {
                throw new RuntimeException("listing scenario '{$name}' is invalid: " . json_encode($e->errors()));
            }
            if (json_encode($canonical($clean)) !== json_encode($canonical($documents[$name]))) {
                throw new RuntimeException("listing scenario '{$name}' does not survive validation unchanged:\n  authored "
                    . json_encode($canonical($documents[$name])) . "\n  clean    " . json_encode($canonical($clean)));
            }
        }
        $saveBaseline($documents['baseline']);
        [$body] = $session();
        $write('listing-session.json', $body);
        $write(
            'listing-samples.json',
            (string) $container->get(Thallo\Core\Http\Controllers\LayoutAdminController::class)
                ->samples(Request::create('/x'), 'listing', 'post')->getContent(),
        );
        $stages = [];
        foreach ($listingScenarios as $scenario) {
            $name = (string) $scenario['name'];
            if (($scenario['placeholder'] ?? false) === true) {
                continue;
            }
            $write("listing-stage-{$name}.html", $render($documents[$name], $name));
            $stages[$name] = ['layout' => $documents[$name], 'file' => "listing-stage-{$name}.html"];
        }
        $write('listing-stages.json', json_encode($stages, JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR));
        $resolver->forget('listing', 'post');

        // The Layouts page with a layout kept while its pages are off the site: the post type taken
        // off the listing types, its listing layout saved — the row removable, and the closed session
        // the page opens to remove it.
        $container->get(Thallo\Core\Settings\GeneralSettings::class)->save(['listing_types' => []]);
        $index = (string) $container->get(Thallo\Core\Http\Controllers\LayoutAdminController::class)
            ->index(Request::create('/v1/layouts', 'GET'))->getContent();
        $kept = array_values(array_filter(
            json_decode($index, true, 512, JSON_THROW_ON_ERROR)['data']['layouts'],
            static fn (array $row): bool => $row['surface'] === 'listing' && $row['target'] === 'post',
        ))[0] ?? null;
        if (($kept['removable'] ?? false) !== true || ($kept['state'] ?? null) !== 'custom') {
            throw new RuntimeException('the unlisted post listing is not a removable kept layout: ' . json_encode($kept));
        }
        $write('layouts-kept.json', $index);
        [$closedBody, $closed] = $session();
        if (!is_string($closed['closed'] ?? null)) {
            throw new RuntimeException('the unlisted post listing opened no closed session');
        }
        $write('listing-closed-session.json', $closedBody);

        // The proofs also drag an Entry title from the palette (refused at the page's root): its tile
        // asks for the type's instance like any other.
        foreach (['entry_title'] as $slug) {
            $built = $factory->make($slug) ?? throw new RuntimeException("no block type '{$slug}'");
            $instances[$slug] = ['block' => $built['block'], 'starter' => $built['starter']];
        }

        foreach ($instances as $slug => $instance) {
            file_put_contents(
                $out . "/api/instance-{$slug}.json",
                json_encode(['success' => true, 'data' => $instance], JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR),
            );
        }
        throw new LayoutFixturesWritten();
    });
} catch (LayoutFixturesWritten) {
    // Written, and rolled back.
} catch (Throwable $e) {
    fwrite(STDERR, 'the listing layout fixtures failed: ' . $e::class . ': ' . $e->getMessage() . "\n");
    exit(1);
}

// ── The shop home layout's stage (type layouts plan C2, S5) ──────────────────────────────────────
// The shop home's layout, saved once as the baseline, and every accepted state the proofs reach —
// authored once in admin/e2e/shop-scenarios.json — rendered through the real session → apply →
// preview path around the shop's first page (ShopPageSeed: 26 products, 24 to a page). The
// `placeholder` state is rendered in a world of its own, a shop with no products, whose stage shows
// the placeholder page's one sample card. `after-remove` is the stage a fresh session opens on once a
// saved layout is removed: the starter, untouched. Each state must come out of the validator
// unchanged. Each world is seeded in a transaction that is rolled back.
$shopScenarios = json_decode(
    (string) file_get_contents($root . '/admin/e2e/shop-scenarios.json'),
    true,
    512,
    JSON_THROW_ON_ERROR,
)['scenarios'];

$shopSeed = new Thallo\Core\Tests\Support\ShopPageSeed($container, TestApplication::instance()->getContext());
$shopTenant = $shopSeed->useTenant();
try {
    $db->transaction(static function () use ($container, $shopScenarios, $shopSeed, $layoutsOut, $out, $canonical): void {
        $write = static fn (string $name, string $body) => file_put_contents($layoutsOut . '/' . $name, $body);
        $factory = $container->get(Thallo\Core\Content\Blocks\BlockFactory::class);
        $preview = $container->get(Thallo\Core\Http\Controllers\LayoutPreviewController::class);
        $admin = $container->get(Thallo\Core\Http\Controllers\LayoutAdminController::class);
        $repo = $container->get(Thallo\Core\Content\Layouts\LayoutRepository::class);
        $resolver = $container->get(Thallo\Core\Content\Layouts\LayoutResolver::class);
        $lock = $container->get(Thallo\Core\Content\Layouts\LayoutWriteLock::class);
        $validator = $container->get(Thallo\Core\Content\Layouts\LayoutValidator::class);
        $hydrator = new Glueful\Validation\RequestDataHydrator();

        $instances = [];
        $expand = static function (array $blocks) use (&$expand, $factory, &$instances): array {
            $made = [];
            foreach ($blocks as $block) {
                if (isset($block['$factory'])) {
                    $slug = (string) $block['$factory'];
                    $built = $factory->make($slug) ?? throw new RuntimeException("no block type '{$slug}'");
                    $instances[$slug] = ['block' => $built['block'], 'starter' => $built['starter']];
                    $block = [
                        'id' => $block['id'],
                        'type' => $built['block']['type'],
                        'data' => array_merge($built['block']['data'], $built['starter']),
                        'settings' => $built['block']['settings'],
                    ];
                }
                foreach ($block['data'] as $key => $value) {
                    if (is_array($value) && array_is_list($value) && ($value === [] || isset($value[0]['type']) || isset($value[0]['$factory']))) {
                        $block['data'][$key] = $expand($value);
                    }
                }
                $made[] = $block;
            }
            return $made;
        };
        $session = static function () use ($preview, $hydrator): array {
            $dto = $hydrator->hydrate(
                Thallo\Core\Http\DTOs\LayoutSessionData::class,
                ['surface' => 'shop_index', 'target' => '@site'],
            );
            $body = (string) $preview->session($dto)->getContent();
            return [$body, json_decode($body, true, 512, JSON_THROW_ON_ERROR)['data']];
        };
        $stage = static function (string $token, string $name) use ($container): string {
            $rendered = $container->get(RenderController::class)->preview(
                Request::create('/_preview/' . $token . '?canvas=1', 'GET'),
                $token,
            );
            $html = (string) $rendered->getContent();
            if ($rendered->getStatusCode() !== 200 || !str_contains($html, 'shop-index--layout')) {
                throw new RuntimeException("the shop '{$name}' stage is not the shop home frame ({$rendered->getStatusCode()})");
            }
            return $html;
        };
        $render = static function (array $document, string $name) use ($preview, $hydrator, $session, $stage): string {
            [, $opened] = $session();
            $token = (string) $opened['token'];
            $applied = $preview->apply($hydrator->hydrate(Thallo\Core\Http\DTOs\ApplyLayoutData::class, [
                'token' => $token, 'layout' => $document, 'epoch' => null, 'base_revision' => null,
            ]));
            if ($applied->getStatusCode() !== 200) {
                throw new RuntimeException("applying the shop '{$name}' layout returned {$applied->getStatusCode()}: {$applied->getContent()}");
            }
            return $stage($token, $name);
        };
        $saveBaseline = static function (array $document) use ($repo, $resolver, $lock): void {
            $lock->within(
                'shop_index',
                '@site',
                fn (): int => $repo->saveExpected('shop_index', '@site', $document['blocks'], $document['settings'], $repo->version('shop_index', '@site'), null),
            );
            $resolver->forget('shop_index', '@site');
        };
        $documents = [];
        foreach ($shopScenarios as $scenario) {
            $documents[(string) $scenario['name']] = ['blocks' => $expand($scenario['layout']['blocks'])] + $scenario['layout'];
        }

        // The placeholder world first: a shop with no products.
        $shopSeed->clear();
        foreach ($shopScenarios as $scenario) {
            $name = (string) $scenario['name'];
            if (($scenario['placeholder'] ?? false) !== true) {
                continue;
            }
            $saveBaseline($documents[$name]);
            [$body, $opened] = $session();
            if ($opened['placeholder'] !== true) {
                throw new RuntimeException("the shop '{$name}' session is not a placeholder session");
            }
            $write('shop-placeholder-session.json', $body);
            $write(
                'shop-placeholder-samples.json',
                (string) $admin->samples(Request::create('/x'), 'shop_index', '@site')->getContent(),
            );
            $html = $render($documents[$name], $name);
            if (!str_contains($html, 'data-thallo-placeholder')) {
                throw new RuntimeException("the shop '{$name}' stage shows no placeholder");
            }
            $write("shop-stage-{$name}.html", $html);
            $write('shop-placeholder-stages.json', json_encode(
                ['baseline' => ['layout' => $documents[$name], 'file' => "shop-stage-{$name}.html"]],
                JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR,
            ));
        }
        $container->get(Glueful\Database\Connection::class)->table('layouts')->where('surface', '=', 'shop_index')->delete();
        $resolver->forget('shop_index', '@site');

        // The sampled world: the seeded shop.
        $shopSeed->seed();
        foreach ($shopScenarios as $scenario) {
            $name = (string) $scenario['name'];
            try {
                $clean = $validator->validate('shop_index', '@site', $documents[$name]['blocks'], $documents[$name]['settings']);
            } catch (Thallo\Core\Content\Validation\ValidationException $e) {
                throw new RuntimeException("shop scenario '{$name}' is invalid: " . json_encode($e->errors()));
            }
            if (json_encode($canonical($clean)) !== json_encode($canonical($documents[$name]))) {
                throw new RuntimeException("shop scenario '{$name}' does not survive validation unchanged:\n  authored "
                    . json_encode($canonical($documents[$name])) . "\n  clean    " . json_encode($canonical($clean)));
            }
        }
        $saveBaseline($documents['baseline']);
        [$body] = $session();
        $write('shop-session.json', $body);
        $write(
            'shop-samples.json',
            (string) $admin->samples(Request::create('/x'), 'shop_index', '@site')->getContent(),
        );
        $stages = [];
        foreach ($shopScenarios as $scenario) {
            $name = (string) $scenario['name'];
            if (($scenario['placeholder'] ?? false) === true) {
                continue;
            }
            $write("shop-stage-{$name}.html", $render($documents[$name], $name));
            $stages[$name] = ['layout' => $documents[$name], 'file' => "shop-stage-{$name}.html"];
        }
        $write('shop-stages.json', json_encode($stages, JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR));

        // After a Remove: the grid layout saved, removed through the admin's Remove, and the session a
        // fresh mint opens — the starter, untouched — with its stage.
        $saveBaseline($documents['grid']);
        [, $removing] = $session();
        $removed = $admin->destroy(
            $hydrator->hydrate(Thallo\Core\Http\DTOs\RemoveLayoutData::class, [
                'token' => $removing['token'], 'expected_lock_version' => $removing['layout']['lock_version'],
            ]),
            Request::create('/x', 'DELETE'),
            'shop_index',
            '@site',
        );
        if ($removed->getStatusCode() !== 200) {
            throw new RuntimeException("removing the shop layout returned {$removed->getStatusCode()}: {$removed->getContent()}");
        }
        $resolver->forget('shop_index', '@site');
        [$afterBody, $after] = $session();
        if (($after['starter'] ?? false) !== true) {
            throw new RuntimeException('the session after the removal is not on the starter');
        }
        $write('shop-after-remove-session.json', $afterBody);
        $write("shop-stage-after-remove.html", $stage((string) $after['token'], 'after-remove'));
        $write('shop-after-remove-stages.json', json_encode(
            ['baseline' => [
                'layout' => ['blocks' => $after['layout']['blocks'], 'settings' => $after['layout']['settings']],
                'file' => 'shop-stage-after-remove.html',
            ]],
            JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR,
        ));

        // The palette tiles the proofs drag (a card block, and one refused at the root) ask for their
        // type's instance like any other.
        foreach (['product_rating', 'product_price', 'product_name'] as $slug) {
            $built = $factory->make($slug) ?? throw new RuntimeException("no block type '{$slug}'");
            $instances[$slug] = ['block' => $built['block'], 'starter' => $built['starter']];
        }
        foreach ($instances as $slug => $instance) {
            file_put_contents(
                $out . "/api/instance-{$slug}.json",
                json_encode(['success' => true, 'data' => $instance], JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR),
            );
        }
        throw new LayoutFixturesWritten();
    });
} catch (LayoutFixturesWritten) {
    // Written, and rolled back.
} catch (Throwable $e) {
    $shopSeed->restoreTenant($shopTenant);
    fwrite(STDERR, 'the shop layout fixtures failed: ' . $e::class . ': ' . $e->getMessage() . "\n");
    exit(1);
} finally {
    $shopSeed->restoreTenant($shopTenant);
}

// The library with Commerce off (shop-patterns.spec.ts): the server's own answer from a second boot
// under a capability override — the same boot the integration tests use for it — restored after.
// Commerce is an activation capability, so its stored switch wins over the override: the boot
// takes place with that switch cleared (and the state version moved), and both are put back after.
$overrideDir = $root . '/config/testing';
$overrideFile = $overrideDir . '/thallo.php';
$previousOverride = is_file($overrideFile) ? (string) file_get_contents($overrideFile) : null;
file_put_contents($overrideFile, "<?php\nreturn " . var_export(['capabilities' => ['thallo.commerce' => false]], true) . ";\n");
$flagsPdo = $container->get(Glueful\Database\Connection::class)->getPDO();
$cleared = $flagsPdo->prepare("DELETE FROM thallo_system_flags WHERE key = 'capability.thallo.commerce.enabled' RETURNING value");
$cleared->execute();
$storedCommerce = $cleared->fetchColumn();
\Thallo\Core\Tests\Support\CapabilityBaseline::advanceVersion($flagsPdo);
\Glueful\Routing\RouteManifest::reset();
\Glueful\Extensions\ServiceProvider::resetLoadedRoutes();
try {
    $withoutCommerce = \Glueful\Framework::create($root)
        ->withConfigDir($root . '/config')
        ->withEnvironment('testing')
        ->boot()
        ->getContext()
        ->getContainer();
    $json('patterns-commerce-off', (string) $withoutCommerce
        ->get(\Thallo\Core\Content\Http\Controllers\PatternController::class)->index(Request::create('/x'))->getContent());
} finally {
    if (is_string($storedCommerce)) {
        $flagsPdo->prepare("INSERT INTO thallo_system_flags (key, value) VALUES ('capability.thallo.commerce.enabled', ?)
            ON CONFLICT (key) DO NOTHING")->execute([$storedCommerce]);
    }
    \Thallo\Core\Tests\Support\CapabilityBaseline::advanceVersion($flagsPdo);
    if ($previousOverride !== null) {
        file_put_contents($overrideFile, $previousOverride);
    } else {
        @unlink($overrideFile);
    }
    \Glueful\Routing\RouteManifest::reset();
    \Glueful\Extensions\ServiceProvider::resetLoadedRoutes();
}

fwrite(STDOUT, "Wrote {$out}/canvas.html and " . count(glob($out . '/api/*.json') ?: []) . " API fixtures for entry {$entryUuid}.\n");
fwrite(STDOUT, 'Wrote ' . count(glob($regionsOut . '/stage-*.html') ?: []) . " regions stages to {$regionsOut}.\n");
fwrite(STDOUT, 'Wrote ' . count(glob($layoutsOut . '/stage-*.html') ?: []) . " layout stages to {$layoutsOut}.\n");
fwrite(STDOUT, 'Wrote ' . count(glob($layoutsOut . '/listing-stage-*.html') ?: []) . " listing layout stages to {$layoutsOut}.\n");
fwrite(STDOUT, 'Wrote ' . count(glob($layoutsOut . '/shop-stage-*.html') ?: []) . " shop layout stages to {$layoutsOut}.\n");
