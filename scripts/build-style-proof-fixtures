#!/usr/bin/env php
<?php
/**
 * Build the fixtures for tools/style-proofs (visual builder spec §2.6): the layer order sheet,
 * the default theme's artifact and its compiled settings artifact, all built by the real
 * classes, and a fixture page whose blocks are styled through the real BlockStyleEmitter from
 * typed settings and style classes. Nothing here boots the application.
 *
 * Usage: php scripts/build-style-proof-fixtures      # writes tools/style-proofs/fixtures/
 */

declare(strict_types=1);

use Thallo\Contracts\Style\StyleTargets;
use Thallo\Core\Content\Blocks\StarterBlockTypes;
use Thallo\Render\Http\Controllers\RenderController;
use Thallo\Render\Style\BlockStyleEmitter;
use Thallo\Render\Style\StyleCompiler;
use Thallo\Render\Style\ThemeStylesheetArtifact;
use Thallo\Render\ThemeLocator;

require __DIR__ . '/../vendor/autoload.php';

$root = dirname(__DIR__);
$out = $root . '/tools/style-proofs/fixtures';
if (!is_dir($out) && !mkdir($out, 0755, true)) {
    fwrite(STDERR, "cannot create {$out}\n");
    exit(1);
}

$theme = new ThemeLocator('default', $root . '/themes');
$vocabulary = $theme->vocabulary();
$dir = $theme->themeDir();
$files = array_map(static fn (string $rel): string => $dir . '/' . $rel, $vocabulary->stylesheets());
file_put_contents($out . '/layers.css', file_get_contents($root . '/packages/thallo-render/assets/style/layers.css'));
file_put_contents($out . '/theme.css', ThemeStylesheetArtifact::build($files)->css);
file_put_contents($out . '/settings.css', StyleCompiler::compile($vocabulary));

$targets = [];
foreach (StarterBlockTypes::definitions() as $definition) {
    if (in_array($definition['slug'], ['heading', 'button', 'hero', 'container'], true)) {
        $targets[$definition['slug']] = StyleTargets::fromDeclaration($definition['style_targets']);
    }
}
// The chrome regions are not block types: what they may be styled with is RegionStyle's.
$targets['header'] = $targets['footer'] = \Thallo\Contracts\Style\RegionStyle::targets();
$emitter = new BlockStyleEmitter();
$token = static fn (string $value): array => ['type' => 'token', 'value' => $value];
$choice = static fn (string $value): array => ['type' => 'choice', 'value' => $value];
$reset = ['type' => 'reset'];
$pad = static fn (array $bps): array => ['spacing' => ['padding' => ['top' => $bps]]];

/** @var array<string, array{block: string, settings: array, classes: list<array>}> */
$cases = [
    // §1.6 table: reusable class base lg, md xl; instance base sm → sm, xl.
    'table-row-1' => ['block' => 'heading', 'settings' => ['classes' => ['c1'], 'style' => $pad(['base' => $token('spacing.sm')])],
        'classes' => [['id' => 'c1', 'style' => $pad(['base' => $token('spacing.lg'), 'md' => $token('spacing.xl')])]]],
    // §1.6 table: same class; instance md sm → lg, sm.
    'table-row-2' => ['block' => 'heading', 'settings' => ['classes' => ['c1'], 'style' => $pad(['md' => $token('spacing.sm')])],
        'classes' => [['id' => 'c1', 'style' => $pad(['base' => $token('spacing.lg'), 'md' => $token('spacing.xl')])]]],
    // A reset terminates resolution at md (class A md xl, class B md lg, instance md reset) and
    // class B's explicit lg still applies.
    'reset-terminates' => ['block' => 'heading', 'settings' => ['classes' => ['a', 'b'], 'style' => $pad(['md' => $reset])],
        'classes' => [
            ['id' => 'a', 'style' => $pad(['md' => $token('spacing.xl')])],
            ['id' => 'b', 'style' => $pad(['md' => $token('spacing.lg'), 'lg' => $token('spacing.sm')])],
        ]],
    // Depth five (spec §5.2): the heading's md padding lands five levels down.
    'five-deep-padding' => ['block' => 'heading', 'nested' => 4,
        'settings' => ['style' => $pad(['md' => $token('spacing.lg')])], 'classes' => []],
    // Responsive padding: base sm, md reset, lg xl.
    'responsive-padding-reset' => ['block' => 'heading', 'settings' => ['style' => $pad([
        'base' => $token('spacing.sm'), 'md' => $reset, 'lg' => $token('spacing.xl'),
    ])], 'classes' => []],
    // Secondary (outline) button: surface accent at base, reset from md → the theme's transparent.
    'secondary-variant-reset' => ['block' => 'button', 'settings' => ['style' => [
        'colors' => ['surface' => $token('color.accent')],
    ]], 'classes' => []],
    'secondary-variant-reset-md' => ['block' => 'button', 'settings' => ['style' => [
        'colors' => ['surface' => $reset],
    ]], 'classes' => []],
    // Radius on the control: none, and reset back to the theme's pill.
    'radius-none' => ['block' => 'button', 'settings' => ['style' => ['radius' => $token('radius.none')]], 'classes' => []],
    'radius-reset' => ['block' => 'button', 'settings' => ['style' => ['radius' => $reset]], 'classes' => []],
    // Hidden at md only, visible again from lg.
    'visibility' => ['block' => 'heading', 'settings' => ['style' => ['visibility' => [
        'md' => $choice('hidden'), 'lg' => $choice('visible'),
    ]]], 'classes' => []],
    // The hero's theme band is a gradient background-image: a surface colour replaces the whole
    // background (transparent clears it, a token paints it), and a reset gives the gradient back.
    'hero-surface-transparent' => ['block' => 'hero', 'settings' => ['style' => [
        'colors' => ['surface' => $token('color.transparent')],
    ]], 'classes' => []],
    'hero-surface-accent' => ['block' => 'hero', 'settings' => ['style' => [
        'colors' => ['surface' => $token('color.accent')],
    ]], 'classes' => []],
    'hero-surface-reset' => ['block' => 'hero', 'settings' => ['style' => [
        'colors' => ['surface' => $reset],
    ]], 'classes' => []],
    // The hero gradient's own colour and strength (Block tab fields, so classes of the template's,
    // not settings): emerald, strong — beside a twin that is the site accent, faint.
    'hero-gradient-emerald-strong' => ['block' => 'hero', 'settings' => [], 'classes' => [],
        'extra' => ' thallo-block-hero--gradient-emerald thallo-block-hero--gradient-strength-strong'],
    // Ken Burns on a container's background: the FRAME clips, its direct picture drifts, and a
    // picture deeper inside — the container's content — does not.
    'ken-burns-zoom-in' => ['block' => 'container', 'settings' => ['style' => [
        'motion' => ['ken_burns' => $choice('zoom-in')],
    ]], 'classes' => []],
    // Line height: tight at base, given back to the theme at md, loose from lg.
    'line-height' => ['block' => 'heading', 'settings' => ['style' => ['typography' => ['line_height' => [
        'base' => $choice('tight'), 'md' => $reset, 'lg' => $choice('loose'),
    ]]]], 'classes' => []],
    // The chrome regions (the Regions page's Style tab). Untouched and sticky, the header is
    // still the theme's translucent, blurred bar — sticky used to repaint it solid.
    'header-sticky-untouched' => ['block' => 'header', 'sticky' => true, 'settings' => [], 'classes' => []],
    // An opacity with no colour chosen mixes the colour the THEME paints the bar with.
    'header-opacity-only' => ['block' => 'header', 'settings' => ['style' => [
        'colors' => ['surface_opacity' => $choice('60')],
    ]], 'classes' => []],
    'footer-opacity-only' => ['block' => 'footer', 'settings' => ['style' => [
        'colors' => ['surface_opacity' => $choice('50')],
    ]], 'classes' => []],
    // A floating bar: its own colour at 80%, no blur, round, lifted, off the top edge, with the
    // border drawn all round where the theme draws the bottom alone.
    'header-floating' => ['block' => 'header', 'settings' => ['style' => [
        'colors' => ['surface' => $token('color.accent'), 'surface_opacity' => $choice('80')],
        'backdrop' => ['blur' => $choice('none')],
        'radius' => $token('radius.full'),
        'shadow' => ['base' => $token('shadow.lg')],
        'spacing' => ['margin' => ['top' => ['base' => $token('spacing.lg')]]],
        'border' => ['width' => $choice('thin'), 'style' => $choice('solid'), 'sides' => $choice('all')],
    ]], 'classes' => []],
    // Padding lands INSIDE the bar, where the theme pads; the footer's border moves to one side.
    'header-padding' => ['block' => 'header', 'settings' => ['style' => [
        'spacing' => ['padding' => ['top' => ['base' => $token('spacing.xl')]]],
    ]], 'classes' => []],
    'footer-border-left' => ['block' => 'footer', 'settings' => ['style' => [
        'border' => ['width' => $choice('thick'), 'style' => $choice('solid'), 'sides' => $choice('left')],
    ]], 'classes' => []],
];

$h = static fn (string $s): string => htmlspecialchars($s, ENT_QUOTES);
$classes = static function (array $case, string $target) use ($emitter, $targets, $h): string {
    $list = $emitter->classesFor($case['settings'], $targets[$case['block']], $target, $case['classes']);
    return $list === [] ? '' : ' ' . $h(implode(' ', $list));
};
$sections = '';
foreach ($cases as $name => $case) {
    if ($case['block'] === 'heading') {
        $markup = '<h2 class="thallo-block thallo-block-heading' . $classes($case, 'root')
            . '" data-target="root">Heading</h2>';
        $control = '<h2 class="thallo-block thallo-block-heading" data-control="root">Heading</h2>';
        // Nested inside the real wrappers a five-deep composition renders (section, columns,
        // card body, container inner), so the theme's nested rules apply to both sides.
        $wrappers = [
            ['<section class="thallo-block thallo-block-section"><div class="thallo-block-section__content">', '</div></section>'],
            ['<div class="thallo-block thallo-block-columns"><div class="thallo-block-columns__col">', '</div></div>'],
            ['<div class="thallo-block thallo-block-card"><div class="thallo-block-card__body">', '</div></div>'],
            ['<div class="thallo-block thallo-block-container"><div class="thallo-block-container__inner">', '</div></div>'],
        ];
        for ($i = 0; $i < (int) ($case['nested'] ?? 0); $i++) {
            [$open, $close] = $wrappers[$i];
            $markup = $open . $markup . $close;
            $control = $open . $control . $close;
        }
    } elseif ($case['block'] === 'header' || $case['block'] === 'footer') {
        // The layout template's own markup for a region-backed bar.
        $tag = $case['block'];
        $bar = "site-{$tag} thallo-region thallo-region-{$tag} thallo-region-{$tag}--contained"
            . (($case['sticky'] ?? false) ? " thallo-region-{$tag}--sticky" : '');
        $region = static fn (string $root, string $inner, string $attr): string => "<{$tag} class=\"{$bar}{$root}\" "
            . "data-{$attr}=\"root\"><div class=\"site-{$tag}__inner{$inner}\" data-{$attr}=\"inner\">Bar</div></{$tag}>";
        $markup = $region($classes($case, 'root'), $classes($case, 'inner'), 'target');
        // The twin is the plain, NON-sticky bar: what the theme draws before any setting.
        $bar = "site-{$tag} thallo-region thallo-region-{$tag} thallo-region-{$tag}--contained";
        $control = $region('', '', 'control');
    } elseif ($case['block'] === 'container') {
        // The container's own markup: the background image is the root's DIRECT child; content
        // pictures are inside the content area.
        $pixel = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
        $band = static fn (string $extra, string $attr): string => '<div class="thallo-block '
            . 'thallo-block-container' . $extra . '" data-' . $attr . '="root">'
            . '<img class="thallo-block-container__bg" data-' . $attr . '="background" alt="" src="' . $pixel . '">'
            . '<div class="thallo-block-container__inner"><img data-' . $attr . '="content" alt="" src="'
            . $pixel . '"></div></div>';
        $markup = $band($classes($case, 'root'), 'target');
        $control = $band('', 'control');
    } elseif ($case['block'] === 'hero') {
        $hero = 'thallo-block thallo-block-hero thallo-block-hero--bg-gradient thallo-block-hero--vertical';
        $markup = '<section class="' . $hero . ($case['extra'] ?? '') . $classes($case, 'root') . '" data-target="root">'
            . '<div class="thallo-block-hero__inner"><h1>Hero</h1></div></section>';
        $control = '<section class="' . $hero . '" data-control="root">'
            . '<div class="thallo-block-hero__inner"><h1>Hero</h1></div></section>';
    } else {
        $link = static fn (string $extra, string $attr): string => '<a class="thallo-block-button__link '
            . 'thallo-block-button__link--outline thallo-block-button__link--primary thallo-block-button__link--md'
            . $extra . '" ' . $attr . ' href="#">Go</a>';
        $markup = '<div class="thallo-block thallo-block-button thallo-block-button--left' . $classes($case, 'root')
            . '" data-target="root">' . $link($classes($case, 'control'), 'data-target="control"') . '</div>';
        $control = '<div class="thallo-block thallo-block-button thallo-block-button--left" data-control="root">'
            . $link('', 'data-control="control"') . '</div>';
    }
    $sections .= "<section data-case=\"{$h($name)}\">{$markup}{$control}</section>\n";
}
$probes = '';
foreach (['spacing.sm', 'spacing.lg', 'spacing.xl', 'color.accent', 'radius.none', 'radius.full'] as $name) {
    $property = str_starts_with($name, 'color.') ? 'background-color' : (str_starts_with($name, 'radius.') ? 'border-radius' : 'padding-top');
    $probes .= "<div data-probe=\"{$h($name)}\" style=\"{$property}: var(" . StyleCompiler::variable($name) . ")\"></div>\n";
}
$html = <<<HTML
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Style proofs</title>
<link rel="stylesheet" href="layers.css">
<link rel="stylesheet" href="theme.css">
<link rel="stylesheet" href="settings.css">
</head>
<body>
{$sections}
<div hidden data-probes>
{$probes}</div>
</body>
</html>
HTML;
file_put_contents($out . '/index.html', $html);
echo "Style proof fixtures written to tools/style-proofs/fixtures/ (" . count($cases) . " cases).\n";
